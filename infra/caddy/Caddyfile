{$FRONTEND_DOMAIN:allka.store} {
	encode zstd gzip
	reverse_proxy frontend:80
}

www.{$FRONTEND_DOMAIN:allka.store} {
	redir https://{$FRONTEND_DOMAIN:allka.store}{uri} permanent
}

{$API_DOMAIN:api.allka.store} {
	encode zstd gzip
	reverse_proxy backend:3001
}

# Central de chamados e roadmap (QA) — Basic Auth removido de propósito
# (decisão do usuário, 2026-08-16): fase de teste interno, sem necessidade
# de senha extra pros funcionários testando. Reinstalar antes de abrir pra
# usuário final — o bloco original fica comentado logo abaixo pra isso.
#
# basic_auth {
# 	{$ROADMAP_QA_BASIC_AUTH_USER} {$ROADMAP_QA_BASIC_AUTH_HASH}
# }
{$ROADMAP_QA_DOMAIN:roadmap-qa.allka.store} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy allka-roadmap-qa-backend:3002
	}
	handle /health {
		reverse_proxy allka-roadmap-qa-backend:3002
	}
	handle {
		reverse_proxy allka-roadmap-qa-frontend:8080
	}
}
