{
  "name": "allka-backend",
  "version": "1.0.0",
  "description": "Allka Platform API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:legacy:generate && tsc",
    "postinstall": "prisma generate && npm run db:legacy:generate",
    "start": "node dist/index.js",
    "test:roadmap-contract": "tsx --test src/lib/roadmap-integration-contract.test.ts",
    "test:unit": "tsx --test src/test-support/require-test-database.test.ts src/lib/product-feedback-access-decision.test.ts src/lib/hmac.test.ts src/lib/product-feedback-config-validation.test.ts src/middleware/auth.test.ts",
    "test:product-feedback": "tsx scripts/run-db-tests.ts src/routes/product-feedback.integration.test.ts",
    "test:e2e:leader-account": "tsx src/scripts/e2e-test-leader-account.ts",
    "test:e2e:agency-seed-repair": "tsx src/scripts/e2e-test-agency-seed-repair.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:legacy:generate": "prisma generate --schema prisma/legacy/schema.prisma",
    "db:legacy:deploy": "prisma migrate deploy --schema prisma/legacy/schema.prisma",
    "import:legacy-snapshot": "tsx src/scripts/import-legacy-snapshot.ts",
    "catalog2:analyze-spreadsheets": "tsx src/scripts/analyze-catalog-spreadsheets.ts",
    "catalog2:seed-classifications": "tsx src/scripts/seed-catalog2-classifications.ts",
    "catalog2:seed-demo": "tsx src/scripts/seed-catalog2-demo.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test-users": "tsx seed-test-users.ts",
    "reset:users-password": "node reset-users-password.cjs",
    "db:seed:products": "tsx seed-all-products.ts",
    "db:seed:tasks": "tsx migrate-tasks.ts",
    "db:seed:catalog-tasks": "tsx src/scripts/seed-catalog-tasks.ts",
    "db:seed:agency-projects": "tsx src/scripts/seed-agency-project-fixtures.ts",
    "db:seed:agencia": "tsx prisma/seed-agencia-data.ts",
    "db:seed:empresa": "tsx prisma/seed-empresa-data.ts",
    "db:seed:lider": "tsx prisma/seed-lider-tasks.ts",
    "db:seed:real": "npm run db:seed:agencia && npm run db:seed:empresa && npm run db:seed:lider",
    "db:seed:demo-realistic": "tsx src/scripts/seed-realistic-demo.ts",
    "db:audit:products": "tsx src/scripts/audit-products.ts",
    "db:repair:product-structure": "tsx src/scripts/repair-product-structure.ts",
    "db:seed:project-tasks": "tsx src/scripts/seed-in-progress.ts",
    "db:seed:qa-project-tasks": "tsx prisma/seed-project-tasks.ts",
    "db:restore": "tsx restore-data.ts",
    "db:backfill:agency-projects": "tsx src/scripts/backfill-agency-projects.ts",
    "db:seed:demo-project-details": "tsx prisma/seed-demo-project-details.ts",
    "db:seed:demo-project-products": "tsx prisma/seed-demo-project-products.ts",
    "db:seed:demo-project-tasks": "tsx prisma/seed-demo-project-tasks.ts",
    "db:seed:demo-project-task-assets": "tsx prisma/seed-demo-project-task-assets.ts",
    "db:seed:demo-project-credentials": "tsx prisma/seed-demo-project-credentials.ts",
    "db:seed:demo-project-billing": "tsx prisma/seed-demo-project-billing.ts",
    "db:seed:demo-partner-projects": "tsx prisma/seed-demo-partner-projects.ts",
    "db:studio": "prisma studio",
    "db:reset": "echo '⛔  Proibido em automação. Use: prisma migrate reset --force (manualmente)'",
    "db:healthcheck": "node -e \"require('dotenv').config();const {PrismaClient}=require('@prisma/client');const p=new PrismaClient();Promise.all([p.product.count(),p.project.count(),p.catalogTask.count(),p.projectTask.count()]).then(([pr,pj,ct,pt])=>console.log(JSON.stringify({products:pr,projects:pj,catalogTasks:ct,projectTasks:pt}))).finally(()=>p.$disconnect())\"",
    "catalog2:import-products": "tsx src/scripts/import-catalog2-products.ts",
    "catalog2:cutover-plan": "tsx src/scripts/catalog2-cutover-plan.ts",
    "catalog2:commercial-cutover-plan": "tsx src/scripts/catalog2-commercial-cutover-plan.ts",
    "catalog2:client-demo": "tsx src/scripts/seed-catalog2-client-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@prisma/client": "^5.22.0",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^5.22.0",
    "sanitize-html": "^2.17.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "mysql2": "^3.23.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
