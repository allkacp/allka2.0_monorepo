// ─── Partners & Campaigns ─────────────────────────────────────────────────────

// Partner NÃO é um tipo de conta separado — é um upgrade que uma Agency já
// existente recebe (convite do admin, aceito pela própria Agency). Por isso
// esta entidade é 1:1 com Agency (agency_id), não com User: o mesmo usuário
// da Agency continua logando normalmente, só ganha acesso extra quando
// status = "active". Todas as relações financeiras/comissão/liderança
// abaixo (PartnerCommission, AgencyLeadership, AgencyReport, etc.)
// continuam apontando pro id desta entidade sem nenhuma mudança — só a
// âncora de identidade (era User, agora é Agency) mudou.
model PartnerProfile {
  id                 String    @id @default(cuid())
  agency_id          String    @unique
  agency             Agency    @relation(fields: [agency_id], references: [id], onDelete: Cascade)
  balance            Float     @default(0)
  total_earned       Float     @default(0)
  total_withdrawn    Float     @default(0)
  referral_link      String?
  referral_code      String?   @unique
  status             String    @default("invited")
  // invited | active | declined | suspended — ciclo de vida do convite:
  // admin convida (invited) -> Agency aceita (active) ou recusa (declined);
  // suspended é uma ação administrativa posterior, não parte do convite.
  invited_at         DateTime?
  responded_at       DateTime?
  pix_key            String?
  pix_key_type       String?
  // cpf | email | phone | random
  address            String?
  number             String?
  neighborhood       String?
  city               String?
  state              String?
  zip_code           String?
  linked_campaign_id String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  commissions        PartnerCommission[]
  led_agencies       AgencyLeadership[]
  agency_reports     AgencyReport[]
  referred_companies Company[]
  withdrawals        PartnerWithdrawal[]
  client_links       ClientLink[]
  projects_owned     Project[]

  @@map("partner_profiles")
}

// Solicitação de saque do Partner — separado de WithdrawalRequest, que é
// exclusivo do fluxo de Nômade (payload/model diferentes: nomade_id vs
// partner_profile_id). Saldo (PartnerProfile.balance) só é debitado quando
// a solicitação é efetivamente processada (status="paid"); ainda não existe
// endpoint/tela admin para aprovar, então toda solicitação fica "pending".
model PartnerWithdrawal {
  id                 String         @id @default(cuid())
  partner_profile_id String
  partner            PartnerProfile @relation(fields: [partner_profile_id], references: [id])
  amount             Float
  pix_key            String
  pix_key_type       String
  // cpf | email | phone | random
  status             String         @default("pending")
  // pending | approved | rejected | paid | cancelled
  notes              String?        @db.LongText
  reviewed_by        String?
  reviewed_at        DateTime?
  requested_at       DateTime       @default(now())
  // processed_at é preenchido especificamente quando status="paid" (momento
  // em que o saldo do Partner é debitado). reviewed_at cobre qualquer
  // decisão do admin (aprovar/reprovar/pagar/cancelar).
  processed_at       DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  @@index([partner_profile_id])
  @@map("partner_withdrawals")
}

model Campaign {
  id               String    @id @default(cuid())
  name             String
  type             String    @default("coupon")
  // coupon | link | referral
  status           String    @default("active")
  // active | paused | ended
  commission_type  String    @default("percentage")
  // percentage | fixed
  commission_value Float     @default(10)
  coupon_code      String?   @unique
  start_date       DateTime?
  end_date         DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  commissions PartnerCommission[]

  @@map("campaigns")
}

model Coupon {
  id                           String    @id @default(cuid())
  code                         String    @unique
  coupon_type                  String    @default("discount")
  // discount | credit-bonus | referral
  discount_type                String    @default("percentage")
  // percentage | fixed
  discount_value               Float     @default(0)
  credit_bonus                 Float     @default(0)
  usage_limit                  Int       @default(0)
  // 0 = unlimited total uses
  usage_limit_per_company      String    @default("unlimited")
  // unlimited | once | custom
  max_uses_per_company         Int       @default(0)
  valid_from                   DateTime?
  valid_until                  DateTime?
  applicable_products          String?   @db.LongText
  // JSON: string[]
  allowed_account_types        String?   @db.LongText
  // JSON: ("empresas" | "agencias" | "nomades")[]
  allowed_company_ids          String?   @db.LongText
  // JSON: string[]
  allowed_user_ids             String?   @db.LongText
  // JSON: string[]
  linked_user_id               String?
  linked_user                  User?     @relation(fields: [linked_user_id], references: [id])
  linked_user_commission_type  String?
  // percentage | fixed
  linked_user_commission_value Float?
  status                       String    @default("active")
  // active | disabled | expired
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(cuid())
  coupon_id  String
  coupon     Coupon   @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])
  used_at    DateTime @default(now())

  @@map("coupon_usages")
}

model PartnerCommission {
  id           String         @id @default(cuid())
  partner_id   String
  partner      PartnerProfile @relation(fields: [partner_id], references: [id])
  campaign_id  String?
  campaign     Campaign?      @relation(fields: [campaign_id], references: [id])
  amount       Float
  status       String         @default("pending")
  // pending | approved | paid
  company_name String?
  project_name String?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  @@map("partner_commissions")
}

// ─── Agency Leadership & Reports ─────────────────────────────────────────────

model AgencyLeadership {
  id         String         @id @default(cuid())
  partner_id String
  partner    PartnerProfile @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  agency_id  String
  agency     Agency         @relation(fields: [agency_id], references: [id], onDelete: Cascade)
  status     String         @default("active")
  // active | paused | ended
  notes      String?        @db.LongText
  started_at DateTime       @default(now())
  ended_at   DateTime?
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@unique([partner_id, agency_id])
  @@map("agency_leaderships")
}

model AgencyReport {
  id             String         @id @default(cuid())
  partner_id     String
  partner        PartnerProfile @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  agency_id      String
  agency         Agency         @relation(fields: [agency_id], references: [id], onDelete: Cascade)
  title          String         @db.VarChar(255)
  content        String         @db.LongText
  period_month   Int
  // 1-12
  period_year    Int
  rating         Int?
  // 1-5 stars
  highlights     String?        @db.LongText
  // JSON: string[]
  improvements   String?        @db.LongText
  // JSON: string[]
  mrr            Float?
  projects_count Int?
  tasks_count    Int?
  status         String         @default("draft")
  // draft | published
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@map("agency_reports")
}

// ─── Match Queue ──────────────────────────────────────────────────────────────

model MatchQueueEntry {
  id           String   @id @default(cuid())
  agency_id    String   @unique
  agency       Agency   @relation(fields: [agency_id], references: [id])
  tier         String   @default("basic")
  // basic | premium | elite
  score        Float    @default(0)
  status       String   @default("active")
  // active | paused | suspended
  position     Int      @default(0)
  joined_queue DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("match_queue_entries")
}

// ─── Payments (Sandbox / Fake Gateway) ───────────────────────────────────────

model Payment {
  id                  String    @id @default(cuid())
  project_id          String
  project             Project   @relation(fields: [project_id], references: [id])
  user_id             String?
  amount              Float
  payment_method      String    @default("CARTAO_TESTE")
  // CARTAO_TESTE | PIX_FAKE | BOLETO_FAKE | CREDITOS | ALLKOINS
  status              String    @default("PENDENTE")
  // PENDENTE | PAGO | FALHOU | CANCELADO
  gateway             String    @default("FAKE_SANDBOX")
  // FAKE_SANDBOX | STRIPE | PAGARME | ASAAS
  fake_transaction_id String?
  card_last_digits    String?
  card_holder         String?
  notes               String?   @db.LongText
  // Confirmação real de pagamento (status -> PAGO) reaproveita este campo
  // já existente em vez de um novo `confirmed_at` redundante.
  paid_at             DateTime?
  // Idempotência real e persistida (substitui o antigo findFirst+observations
  // em texto livre). Identifica esta TENTATIVA/cobrança específica — ver
  // src/lib/confirm-payment.ts. Formato: fake:{paymentId}:{billingCycleKey}
  // depois de confirmado (ou draft:{projectId}:{cycleKey} enquanto ainda
  // PENDENTE e sem payment_id conhecido pelo chamador).
  idempotency_key     String?   @unique
  // Identifica o ciclo coberto por este pagamento: "avulso" para contratação
  // avulsa, ou "YYYY-MM" para o ciclo mensal efetivamente pago.
  billing_cycle_key   String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  generated_tasks ProjectTask[] @relation("PaymentGeneratedTasks")
  items           PaymentItem[]

  @@map("payments")
}

// ─── PaymentItem — snapshot congelado dos ProjectProducts cobertos por um
// Payment específico ─────────────────────────────────────────────────────
// Sem isto, Payment não registrava explicitamente QUAIS ProjectProducts
// foram pagos — reprocessamento e auditoria dependiam de reconsultar os
// produtos ATUAIS do projeto, o que quebra assim que um produto é
// adicionado/removido depois do pagamento. Uma vez criado, um PaymentItem
// nunca é alterado (histórico comercial imutável, mesmo padrão dos
// snapshots em ProjectProduct).
model PaymentItem {
  id         String  @id @default(cuid())
  payment_id String
  payment    Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  project_product_id String
  project_product    ProjectProduct @relation(fields: [project_product_id], references: [id])
  product_id         String?
  product            Product?       @relation(fields: [product_id], references: [id], onDelete: SetNull)

  product_name_snapshot String
  unit_price_snapshot   Float
  // Não existe hoje campo de "quantidade contratada" em ProjectProduct —
  // sempre 1 nesta fase (reservado pra quando essa noção existir).
  quantity_snapshot     Int     @default(1)
  total_snapshot        Float
  recurrence_snapshot   String?
  // Ciclo ao qual este item pertence — espelha Payment.billing_cycle_key no
  // momento da criação (fica preservado mesmo se o Payment for editado).
  billing_cycle_key     String?

  created_at DateTime @default(now())

  // Mesmo ProjectProduct não pode aparecer duas vezes no mesmo Payment —
  // como cada Payment já pertence a exatamente um ciclo, isso também cobre
  // "não duas vezes no mesmo Payment E ciclo".
  @@unique([payment_id, project_product_id])
  @@index([payment_id])
  @@index([project_product_id])
  @@map("payment_items")
}

// ─── Expenses (Despesas Operacionais) ────────────────────────────────────────
// Separate from CMV/costs (precificação). These are operating expenses of Allka.

model Expense {
  id                String    @id @default(cuid())
  name              String
  description       String?   @db.LongText
  category          String    @default("Outros")
  // Administrativo | Ferramentas e Sistemas | Marketing | Financeiro |
  // Jurídico/Contábil | Infraestrutura | Pessoas | Operacional | Impostos e Taxas | Outros
  amount            Float
  type              String    @default("fixa")
  // fixa | variável
  recurrence        String    @default("mensal")
  // única | mensal | anual | personalizada
  status            String    @default("prevista")
  // prevista | pendente | paga | atrasada | cancelada
  due_date          DateTime?
  paid_at           DateTime?
  payment_method    String?
  // pix | transferência | cartão | boleto | débito | dinheiro | outro
  department        String?
  // Administrativo | Financeiro | Marketing | Tecnologia | Jurídico | Pessoas | Operacional | Outros
  competence_month  String?
  // Format: "YYYY-MM" — competence month reference
  notes             String?   @db.LongText
  attachment_url    String?   @db.LongText
  // recurrence control
  recurrence_id     String?
  // groups recurring instances — same recurrence_id = same recurring expense series
  is_recurring_base Boolean   @default(false)
  // true = this is the base/template of a recurring series
  created_by        String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([competence_month])
  @@index([recurrence_id])
  @@map("expenses")
}

// ─── Wallets & Ledger ─────────────────────────────────────────────────────────

model Wallet {
  id              String   @id @default(cuid())
  owner_type      String
  // "company" | "agency" | "nomad" | "partner" | "platform"
  owner_id        String
  balance         Float    @default(0)
  blocked_balance Float    @default(0)
  currency        String   @default("BRL")
  status          String   @default("active")
  // "active" | "suspended" | "closed"
  notes           String?  @db.LongText
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  ledger WalletLedger[]

  @@unique([owner_type, owner_id])
  @@index([owner_type])
  @@index([status])
  @@map("wallets")
}

model WalletLedger {
  id              String   @id @default(cuid())
  wallet_id       String
  wallet          Wallet   @relation(fields: [wallet_id], references: [id])
  type            String
  // credit | debit | adjustment | block | unblock | refund | commission | withdrawal | payment | fee | bonus | penalty
  direction       String
  // credit | debit
  amount          Float
  balance_before  Float
  balance_after   Float
  description     String
  category        String?
  status          String   @default("confirmed")
  // pending | confirmed | failed | reversed
  reference_type  String?
  // payment | invoice | withdrawal | commission | expense | project | adjustment
  reference_id    String?
  idempotency_key String?  @unique
  metadata        Json?
  created_by      String?
  notes           String?  @db.LongText
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([wallet_id])
  @@index([type])
  @@index([direction])
  @@index([status])
  @@index([created_at])
  @@index([reference_type, reference_id])
  @@map("wallet_ledger")
}

// ─── Report Configuration & Permissions ──────────────────────────────────────

model ReportConfig {
  id                    String   @id @default(cuid())
  report_key            String   @unique
  // Matches report.id from the frontend catalog: "revenue", "invoices", "cashflow", etc.
  is_active             Boolean  @default(true)
  allowed_account_types String?  @db.LongText
  // JSON: string[] — e.g., ["agencias","empresas","nomades","parceiro","lider"]
  allowed_roles         String?  @db.LongText
  // JSON: string[] — e.g., ["agency_admin","company_admin"]
  allowed_user_ids      String?  @db.LongText
  // JSON: string[] — specific user IDs always allowed
  blocked_user_ids      String?  @db.LongText
  // JSON: string[] — specific user IDs always blocked
  data_scope            String   @default("GLOBAL")
  // GLOBAL | OWN_PROFILE_SCOPE | OWN_COMPANY_SCOPE | OWN_AGENCY_SCOPE | OWN_NOMAD_SCOPE | OWN_PARTNER_SCOPE | OWN_LEADER_SCOPE | CUSTOM_USERS
  can_export            Boolean  @default(true)
  can_change_filters    Boolean  @default(true)
  only_related_data     Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@map("report_configs")
}

// ─── Usage Events (platform analytics) ───────────────────────────────────────
// Additive model for page-view and funnel tracking. Writing is opt-in via
// POST /api/reports/usage-event. Reading feeds the Usabilidade indicator.

model UsageEvent {
  id           String   @id @default(cuid())
  user_id      String
  account_type String
  // agencias | empresas | nomades | admin | parceiro
  route        String   @db.VarChar(500)
  // e.g. "/projetos", "/checkout/montagem", "/tarefas"
  event_type   String
  // "page_view" | "login" | "project_start" | "project_abandon"
  // | "checkout_start" | "checkout_complete" | "checkout_abandon"
  session_id   String?
  // client-generated session identifier for funnel grouping
  metadata     String?  @db.LongText
  // JSON: any extra context (product_id, task_id, etc.)
  created_at   DateTime @default(now())

  @@index([user_id])
  @@index([account_type])
  @@index([event_type])
  @@index([created_at])
  @@index([session_id])
  @@map("usage_events")
}

// ─── Squad (plano pós-pago com limite de crédito) ────────────────────────────

model SquadConfig {
  id              String    @id @default(cuid())
  company_id      String    @unique
  company         Company   @relation(fields: [company_id], references: [id])
  credit_limit    Float     @default(10000)
  // Limite máximo que a carteira pode ficar negativa
  monthly_minimum Float     @default(0)
  // Consumo mínimo mensal garantido
  billing_day     Int       @default(10)
  // Dia do mês em que o ciclo fecha (1–28)
  payment_terms   Int       @default(10)
  // Dias após fechamento para vencimento da fatura
  status          String    @default("active")
  // active | paused | cancelled | delinquent
  notes           String?   @db.LongText
  consultant_id   String?
  // Soft ref para User responsável comercial
  started_at      DateTime  @default(now())
  ended_at        DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  cycles SquadCycle[]

  @@map("squad_configs")
}

model SquadCycle {
  id                 String      @id @default(cuid())
  squad_config_id    String
  squad_config       SquadConfig @relation(fields: [squad_config_id], references: [id])
  company_id         String
  started_at         DateTime
  closed_at          DateTime?
  due_at             DateTime?
  status             String      @default("open")
  // open | closed | invoiced | paid | overdue | cancelled
  total_consumed     Float       @default(0)
  // Soma de todos os débitos do ciclo
  minimum_adjustment Float       @default(0)
  // max(0, monthly_minimum - total_consumed)
  total_invoiced     Float       @default(0)
  // max(total_consumed, monthly_minimum)
  invoice_id         String?     @unique
  // FK suave para Invoice quando ciclo é faturado
  notes              String?     @db.LongText
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  @@index([company_id])
  @@index([status])
  @@index([squad_config_id])
  @@map("squad_cycles")
}

// ─── ProjectCredential — Cofre do Projeto ────────────────────────────────────

model ProjectCredential {
  id String @id @default(cuid())

  project_id         String
  project_task_id    String?
  project_product_id String?

  // Identificação
  title         String
  service       String?
  // Ex: "Meta Ads", "Google Analytics", "WordPress Admin"
  url           String?
  username      String?
  password_demo String?
  // DEMO ONLY — never use real passwords here
  notes         String? @db.LongText
  category      String  @default("other")
  // social | ads | analytics | hosting | cms | email | ecommerce | design | other

  // Status operacional
  status String @default("active")
  // active | expiring | expired | rotation_required | shared | revoked | archived

  // Controle demo
  is_demo Boolean @default(true)

  // Alertas de segurança
  requires_rotation Boolean   @default(false)
  rotation_reason   String?
  last_rotated_at   DateTime?
  expires_at        DateTime?

  // Compartilhamento (string IDs — sem FK para evitar deleção acidental)
  shared_until         DateTime?
  shared_with_user_id  String?
  shared_with_nomad_id String?

  // Auditoria
  created_by String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relações
  project         Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_task    ProjectTask?    @relation(fields: [project_task_id], references: [id], onDelete: SetNull)
  project_product ProjectProduct? @relation(fields: [project_product_id], references: [id], onDelete: SetNull)

  access_logs ProjectCredentialAccessLog[]

  @@unique([project_id, title])
  @@index([project_id])
  @@index([project_task_id])
  @@index([project_product_id])
  @@index([status])
  @@index([category])
  @@index([shared_with_user_id])
  @@index([shared_with_nomad_id])
  @@map("project_credentials")
}

// ─── ProjectCredentialAccessLog — Histórico de acesso ao Cofre ───────────────

model ProjectCredentialAccessLog {
  id String @id @default(cuid())

  credential_id String
  credential    ProjectCredential @relation(fields: [credential_id], references: [id], onDelete: Cascade)

  action         String
  // created | viewed | copied | shared | revoked | rotated | edited | archived | deleted
  actor_type     String?
  // user | nomad | system
  actor_user_id  String?
  actor_nomad_id String?
  details        String? @db.LongText

  created_at DateTime @default(now())

  @@index([credential_id])
  @@index([action])
  @@index([created_at])
  @@index([actor_user_id])
  @@index([actor_nomad_id])
  @@map("project_credential_access_logs")
}

// ─── ProjectConnection — vínculo OAuth com uma plataforma externa ───────────
// Distinto de propósito de ProjectCredential acima: aquele é o "Cofre do
// Projeto" — senha de demonstração digitada por um humano. Este é um token
// OAuth conquistado pela máquina através do fluxo de consentimento da
// própria plataforma (Meta, Google, TikTok). Nunca misturar os dois.

model ProjectConnection {
  id String @id @default(cuid())

  project_id String
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  provider String
  // meta_ads | google_ads | google_analytics | google_business | tiktok_ads
  // Só "meta_ads" tem OAuth/sincronização de verdade por enquanto — os
  // outros 5 entram depois sem precisar de um modelo novo.

  status String @default("connected")
  // connected | expired | disconnected | error

  external_account_id   String
  // Meta: id da conta de anúncio, ex. "act_123456789".
  external_account_name String?

  scopes String? @db.LongText
  // Escopos realmente concedidos, devolvidos pela plataforma — só auditoria,
  // nunca usado para decidir comportamento.

  access_token_encrypted String @db.LongText
  // AES-256-GCM, ver lib/token-encryption.ts — NUNCA texto puro. Sem campo
  // de refresh_token: o modelo de token de longa duração da Meta não tem
  // refresh clássico — ver token_expires_at abaixo.

  token_expires_at DateTime?
  // ~60 dias pra Meta. Fica nullable pensando em futuros provedores cujo
  // token não expira de forma rotativa.

  last_synced_at DateTime?
  last_error     String? @db.LongText

  // Id solto, sem FK — mesmo padrão de ProjectCredential.created_by acima
  // (auditoria, não vínculo de integridade referencial).
  connected_by_user_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  metrics_daily ProjectConnectionMetricDaily[]

  @@unique([project_id, provider])
  @@index([project_id])
  @@index([provider])
  @@index([status])
  @@index([connected_by_user_id])
  @@map("project_connections")
}

// ─── ProjectConnectionMetricDaily — uma linha por conexão por dia ───────────
// Colunas tipadas pras métricas comuns a todo provedor de anúncios (soma
// barata pro widget) + uma coluna `raw` de reserva — mesmo espírito de
// LegacyRecord logo abaixo (colunas comuns tipadas + JSON pra o resto) e de
// NotificationRule.target_account_types já usando Json pra campo aberto.
// `raw` é o que permite Google Ads/TikTok (métricas diferentes) usarem esta
// mesma tabela depois sem uma migration por provedor.

model ProjectConnectionMetricDaily {
  id String @id @default(cuid())

  connection_id String
  connection    ProjectConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  date DateTime @db.Date
  // Dia de calendário representado por esta linha (bucket time_increment=1
  // do Insights da Meta).

  impressions Int?
  clicks      Int?
  spend       Float?
  reach       Int?
  ctr         Float?
  cpc         Float?

  raw Json?
  // Linha bruta do Insights daquele dia, na íntegra.

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([connection_id, date])
  @@index([connection_id])
  @@index([date])
  @@map("project_connection_metrics_daily")
}

// ─── Arquivo histórico da plataforma antiga ──────────────────────────────────
// Tabela ISOLADA de propósito: nenhuma FK sai daqui para as tabelas da
// plataforma, e nenhuma aponta para cá. Os vínculos ficam como ids soltos
// (projeto_legacy_id, agencia_legacy_id, ...), resolvidos por consulta.
//
// É o que permite apagar todo o histórico importado depois com um TRUNCATE,
// sem quebrar nada nem deixar órfão. Guarda o dado que NÃO vira registro
// operacional da plataforma nova — hoje o financeiro (faturamento, carteira,
// repasses), amanhã o que mais for puxado do dump.
model LegacyRecord {
  id     String @id @default(cuid())
  origem String @db.VarChar(60)
  // bloco de origem: "financeiro", etc.
  tabela String @db.VarChar(80)
  // nome da tabela no dump antigo (billing, wallet_transaction, ...)

  legacy_id Int?
  // id da linha na tabela de origem

  // Vínculos soltos, sem constraint — cruzam com o legacy_id das entidades.
  projeto_legacy_id Int?
  agencia_legacy_id Int?
  cliente_legacy_id Int?
  nomade_legacy_id  Int?
  conta_legacy_id   Int?

  valor Float?
  data  DateTime?

  dados String @db.LongText
  // linha original inteira, em JSON

  created_at DateTime @default(now())

  @@unique([tabela, legacy_id])
  @@index([origem])
  @@index([tabela])
  @@index([projeto_legacy_id])
  @@index([agencia_legacy_id])
  @@index([nomade_legacy_id])
  @@index([data])
  @@map("legacy_records")
}

// ── Acesso ao produto "Ajuda e sugestões" (integração Allka <-> Roadmap) ──
// Decisão de autorização é sempre desta plataforma (Allka), nunca do
// Roadmap — ver lib/product-feedback-access-decision.ts, a única função
// canônica que lê estes 4 primeiros modelos para decidir canUse. Os campos
// enabled/default_policy/effect/priority usam String (não enum do Prisma)
// só porque o restante do schema já segue esse padrão em todo o arquivo.

// Singleton: sempre uma única linha, id fixo "singleton" — ver
// resolveProductFeedbackConfig() no backend. Não modelar como settings
// genérico porque este produto tem regras de leitura próprias (ver
// decideProductFeedbackAccess) e não precisa de um KV genérico.
model ProductFeedbackAccessConfig {
  id             String   @id @default(cuid())
  enabled        Boolean  @default(true)
  default_policy String   @default("ALLOW_ALL_ACTIVE")
  // ALLOW_ALL_ACTIVE | DENY_ALL_EXCEPT_ALLOWED
  updated_by_id  String?
  // Sem relation formal pra User de propósito — é só rastro de auditoria
  // (quem mexeu por último), resolvido por consulta no endpoint de admin,
  // igual ao StatusHistory.createdBy do lado Roadmap.
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("product_feedback_access_configs")
}

model ProductFeedbackAccessGroup {
  id            String    @id @default(cuid())
  name          String
  effect        String
  // ALLOW | DENY
  priority      Int       @default(0)
  active        Boolean   @default(true)
  expires_at    DateTime?
  reason        String?   @db.Text
  archived_at   DateTime?
  created_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  members ProductFeedbackAccessGroupMember[]

  @@index([active])
  @@index([effect, priority])
  @@index([archived_at])
  @@map("product_feedback_access_groups")
}

model ProductFeedbackAccessGroupMember {
  id          String                     @id @default(cuid())
  group_id    String
  group       ProductFeedbackAccessGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  added_by_id String?
  created_at  DateTime                   @default(now())

  @@unique([group_id, user_id])
  @@index([user_id])
  @@map("product_feedback_access_group_members")
}

// Uma linha por usuário no máximo (@unique em user_id) — "sem override"
// simplesmente não tem linha aqui, não uma linha com effect=INHERIT (embora
// INHERIT também seja um valor válido, pra permitir "eu já tive uma decisão
// aqui e agora quero voltar explicitamente a herdar dos grupos/política").
model ProductFeedbackUserOverride {
  id            String    @id @default(cuid())
  user_id       String    @unique
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  effect        String
  // ALLOW | DENY | INHERIT
  active        Boolean   @default(true)
  expires_at    DateTime?
  reason        String?   @db.Text
  updated_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("product_feedback_user_overrides")
}

model ProductFeedbackAccessAudit {
  id             String   @id @default(cuid())
  actor_id       String?
  target_user_id String?
  action         String
  // ex.: "config.updated" | "override.set" | "group.created" |
  // "group.archived" | "group.member_added" | "group.member_removed"
  before_json    String?  @db.Text
  after_json     String?  @db.Text
  reason         String?  @db.Text
  created_at     DateTime @default(now())

  @@index([target_user_id])
  @@index([actor_id])
  @@index([action])
  @@index([created_at])
  @@map("product_feedback_access_audits")
}

// Um chamado aberto por um usuário Allka via a integração — o espelho local
// do que existe no Roadmap (identificado só pelo protocolo ALK-...), pra
// "Meus chamados" não depender de o Roadmap estar sempre no ar pra listar
// pelo menos os protocolos e o último status conhecido.
// Doubles as this feature's local idempotency ledger, not just a display
// cache. idempotency_key is the frontend-generated clientSubmissionId
// (stable across retries of the same logical submit — see
// product-feedback-widget.tsx), reused as-is as the idempotencyKey sent to
// the Roadmap. A row is created BEFORE the Roadmap call, with protocol
// still null — that's the "pending" state a retry finds and resumes from
// if the previous attempt crashed/timed out between calling the Roadmap
// and finishing the local write. payload_hash lets a retry be told apart
// from a genuine reuse-with-different-content (409), without needing a
// network round trip to the Roadmap just to find out.
model ProductFeedbackWorkItemLink {
  id                String    @id @default(cuid())
  user_id           String
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  protocol          String?   @unique
  payload_hash      String
  correlation_id    String
  idempotency_key   String    @unique
  type              String
  // PROBLEM | IDEA | IMPROVEMENT
  title             String
  cached_status     String?
  cached_updated_at DateTime?
  created_at        DateTime  @default(now())

  @@index([user_id])
  @@map("product_feedback_work_item_links")
}

// ─── Dashboard share links ──────────────────────────────────────────────────
// Antes (v1/v2) o "link" era só um payload Base64 decodificado no cliente —
// sem registro no banco, qualquer um podia forjar um token arbitrário (ex.
// profile: "admin", sem pin) e a rota pública de dados aceitava. Este model
// torna o link opaco (token aleatório, ver routes/share.ts) e movable/
// revogável: a config de verdade mora aqui, o token só é a chave de lookup.
// scope_id é sempre resolvido pelo SERVIDOR a partir de quem criou o link
// (nunca aceito do cliente, exceto pra admin) — ver resolveOwnScopeId em
// routes/share.ts.
model ShareLink {
  id                   String    @id @default(cuid())
  token                String    @unique
  // URL amigável opcional (ex.: "visao-financeira") — só serve pra
  // LOCALIZAR o registro, nunca pra autorizar nada; todo o resto (status,
  // revoked_at, expires_at, deleted_at, PIN, permission, escopo) continua
  // sendo checado depois de resolvido, exatamente como acontece hoje com
  // o token (ver findShareLinkByIdentifier em routes/share.ts). Opcional e
  // único globalmente — link antigo sem slug continua funcionando só pelo
  // token. Nunca reaproveitado: revogar/arquivar não libera o slug (evita
  // uma URL antiga de cliente futuramente apontar pra outro conteúdo);
  // editar o slug troca o valor da própria linha, o slug anterior fica
  // livre pra qualquer um (sem alias/redirect — decisão deliberada, ver
  // PATCH /api/dashboard-shares/:id).
  slug                 String?   @unique
  target_id            String
  target_type          String
  // widget | dashboard
  target_title         String
  permission           String
  // view | comment
  pin_hash             String?
  profile              String
  // admin | agency | company | nomad | partner | leader
  scope_id             String?
  period_type          String?
  period_from          DateTime?
  period_to            DateTime?
  period_label         String?
  allow_filter_changes Boolean   @default(false)
  expires_at           DateTime?
  revoked_at           DateTime?
  // Soft-delete/arquivamento (ver routes/dashboard-shares.ts) — some da
  // listagem operacional padrão e passa a ser tratado como inválido nas
  // rotas públicas de routes/share.ts, mas a linha (e os comentários que
  // dependem dela via FK) continua no banco. Nunca DELETE destrutivo aqui:
  // é a base pro item futuro de audit log.
  deleted_at           DateTime?
  created_by           String
  creator              User      @relation(fields: [created_by], references: [id], onDelete: Cascade)
  created_at           DateTime  @default(now())
  comments             ShareComment[]
  activities           ShareLinkActivity[]

  @@index([created_by])
  @@map("share_links")
}

// Auditoria persistente das ações administrativas sobre um ShareLink (item
// 8) — sobrevive a revogação/expiração/arquivamento de propósito: mesmo um
// link arquivado (deleted_at setado) continua com o histórico completo no
// banco, só some da listagem operacional. Nome/e-mail do ator são
// SNAPSHOT no momento da ação (não FK só pro User atual) — se a conta for
// removida ou renomeada depois, o log continua legível com quem fez o quê
// na época. Nunca grava PIN em texto puro, pin_hash, JWT ou qualquer
// segredo — ver ACTIVITY_ACTIONS e redactMetadata em lib/share-link-activity.ts.
model ShareLinkActivity {
  id             String    @id @default(cuid())
  share_link_id  String
  share_link     ShareLink @relation(fields: [share_link_id], references: [id], onDelete: Cascade)
  action         String
  // created | slug_changed | permission_changed | pin_enabled | pin_changed
  // | pin_removed | expiry_changed | revoked | reactivated | archived
  actor_user_id  String?
  actor_name     String?
  actor_email    String?
  // JSON só com valores seguros (ex.: {"from":"view","to":"comment"}) —
  // nunca PIN/hash/token. Ver redactMetadata.
  metadata       Json?
  created_at     DateTime  @default(now())

  @@index([share_link_id, created_at])
  @@map("share_link_activities")
}

// Comentários em dashboards/widgets compartilhados (permission="comment").
// Não duplica target_id/target_type — isso já vem do ShareLink; um
// comentário sempre herda o escopo (dashboard inteiro ou widget específico)
// do link em que foi feito. Autor: se quem comenta está autenticado na
// plataforma (Authorization: Bearer enviado pelo próprio browser da pessoa,
// não pelo token do link), user_id/author_name/author_email vêm do JWT,
// nunca do corpo da requisição — ver routes/share.ts. Visitante sem sessão
// preenche nome/e-mail uma vez; e-mail é obrigatório pra ter alguma
// identificação mínima persistida.
model ShareComment {
  id             String    @id @default(cuid())
  share_link_id  String
  share_link     ShareLink @relation(fields: [share_link_id], references: [id], onDelete: Cascade)
  // Nullable: comentário pode ser só anexo (ver regra em routes/share.ts —
  // content vazio + attachments.length === 0 é o único caso rejeitado).
  content        String?   @db.LongText
  // "plain": texto puro, formato de todo comentário criado antes do editor
  // rico — continua renderizado como sempre foi (cor única em `color`,
  // sem HTML). "html": HTML restrito sanitizado no backend (ver
  // sanitizeRichContent em routes/share.ts) — cor/tamanho por trecho vêm
  // de classes dentro do próprio HTML, `color` é ignorado nesse caso.
  // Default "plain" propositalmente: nenhuma migração destrutiva precisa
  // tocar as linhas já existentes.
  content_format String    @default("plain")
  // Cor única do comentário INTEIRO — só usada quando content_format=
  // "plain" (comentário antigo/sem rich text). Chave de uma paleta fixa
  // validada no backend, nunca CSS arbitrário.
  color          String    @default("default")
  author_name    String?
  author_email   String
  author_whatsapp String?
  user_id        String?
  user           User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  status         String    @default("visible")
  // visible | deleted (soft delete — reservado para moderação futura, não
  // implementada nesta tarefa)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  attachments    ShareCommentAttachment[]

  @@index([share_link_id])
  @@map("share_comments")
}

// Anexos (imagem/PDF) de um comentário — separado do ShareComment porque um
// comentário pode ter mais de um arquivo. Storage local em disco, mesmo
// padrão de apps/backend/src/lib/file-storage.ts já usado por
// ProjectAttachment (routes/projects.ts) — sem infra nova.
model ShareCommentAttachment {
  id         String       @id @default(cuid())
  comment_id String
  comment    ShareComment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  filename   String
  // Nome original enviado pela pessoa — exibido na UI.
  mime_type  String
  size       Int
  // storage_key = nome gerado em disco (uploads/share-comments/{comment_id}/{storage_key}),
  // nunca o filename original (evita colisão e path traversal).
  storage_key String
  created_at DateTime     @default(now())

  @@index([comment_id])
  @@map("share_comment_attachments")
}

// ─── Dashboard Templates (padrão por perfil) — Item 9/10 ─────────────────────
// Template administrativo global, separado da personalização individual do
// usuário (que continua vivendo em localStorage — ver
// apps/frontend/lib/dashboard-presets-by-role.ts). Um usuário sem
// personalização própria recebe o template default do seu perfil como base
// inicial; editar o próprio dashboard NUNCA grava aqui, e editar o template
// aqui NUNCA sobrescreve quem já personalizou (ver GET /resolve em
// routes/dashboard-templates.ts).
model DashboardTemplate {
  id          String    @id @default(cuid())
  name        String
  profile     String
  // admin | agency | company | nomad | partner | leader — mesmo vocabulário
  // já usado em ShareLink.profile, não o DashboardRole (maiúsculo) do
  // frontend; a rota normaliza para minúsculo nos dois sentidos.
  is_default  Boolean   @default(false)
  // Só pode haver 1 default ativo por profile — garantido em transaction em
  // POST /:id/set-default (nunca por unique constraint composta, porque
  // teríamos vários templates com is_default=false simultâneos).
  is_active   Boolean   @default(true)
  widgets     Json
  // Array de WidgetState — mesmo shape (id/type/visible/order/customTitle?/
  // colSpan?) usado hoje em localStorage pelas 6 telas (ver
  // features/dashboards/shared/dashboard-common.tsx). Guardado como JSON
  // estruturado (não texto livre) pra não perder nenhum campo existente.
  created_by  String?
  creator     User?     @relation(fields: [created_by], references: [id], onDelete: SetNull)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  contents    DashboardTemplateContent[]

  @@index([profile, is_active])
  @@index([profile, is_default])
  @@map("dashboard_templates")
}

// Banner/aviso fixo vinculado a um template. `locked=true` = o usuário não
// pode remover da própria visão (faz parte da experiência padrão do
// perfil); `locked=false` = pode ser dispensado individualmente (dispensa
// fica em localStorage, mesmo padrão de persistência pessoal do item 9).
model DashboardTemplateContent {
  id                 String            @id @default(cuid())
  template_id        String
  template           DashboardTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  type               String
  // banner | notice
  title              String
  body               String?           @db.Text
  image_storage_key  String?
  // Nome gerado em disco (uploads/dashboard-template-contents/{id}/{key}) —
  // mesmo padrão de ShareCommentAttachment.storage_key, nunca o nome
  // original. Servido publicamente (sem auth) por ser conteúdo de
  // marketing interno não sensível — ver GET /contents/:id/image.
  image_mime_type    String?
  link_url           String?
  link_label         String?
  active             Boolean           @default(true)
  starts_at          DateTime?
  ends_at            DateTime?
  sort_order         Int               @default(0)
  locked             Boolean           @default(false)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  @@index([template_id, active])
  @@map("dashboard_template_contents")
}
