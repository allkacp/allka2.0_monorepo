// ─── Projects & Tasks ─────────────────────────────────────────────────────────

model Project {
  id                   String          @id @default(cuid())
  title                String
  description          String?         @db.LongText
  client_id            String?
  client               Company?        @relation("ProjectLegacyClient", fields: [client_id], references: [id])
  // ── Novo escopo estruturado (adicional ao legado acima; não usado pelos
  // projetos existentes, que continuam funcionando só por agency/client_id) ──
  // No máximo um dos três deve estar preenchido — regra aplicada em código,
  // não em constraint de banco (mesmo padrão do ClientLink).
  agency_id            String?
  agency_owner         Agency?         @relation(fields: [agency_id], references: [id], onDelete: SetNull)
  company_id           String?
  company_owner        Company?        @relation("ProjectNewCompanyOwner", fields: [company_id], references: [id], onDelete: SetNull)
  partner_id           String?
  partner_owner        PartnerProfile? @relation(fields: [partner_id], references: [id], onDelete: SetNull)
  // Autoria real do projeto — sempre resolvida pelo backend a partir do
  // token autenticado (nunca aceita do payload). Distinta do ownership
  // organizacional acima (agency_id/company_id/partner_id), que continua
  // sendo o filtro usado para escopo de listagem. Nullable só porque os 3
  // fixtures "sem vínculo" do seed local são inseridos direto pelo script,
  // sem passar pela API — todo projeto real criado via POST /api/projects
  // sempre tem isto preenchido.
  created_by_user_id   String?
  created_by           User?           @relation("ProjectCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  // Código público sequencial e persistente (proj_00001, proj_00002, ...).
  // Obrigatório desde a fase 2 da migration (depois do backfill dos
  // projetos existentes) — toda linha nova recebe um valor via
  // getNextSequenceValue(tx, "project") — ver src/lib/sequence.ts.
  project_code         String          @unique
  status               String          @default("draft")
  // draft | negotiation | awaiting-payment | planning | in-progress | paused | completed | cancelled | paid
  // draft | negotiation | awaiting-payment | planning | in-progress | paused | completed | cancelled
  lifecycle            String          @default("avulso")
  // avulso | mensal
  type                 String?
  // Marketing Digital | Desenvolvimento Web | Design | E-commerce | Desenvolvimento Mobile | Consultoria
  value                Float           @default(0)
  budget               Float           @default(0)
  spent                Float           @default(0)
  progress             Int             @default(0)
  agency               String?
  company_type         String?
  // company | agency | nomad
  consultant           String?
  consultant_email     String?
  team_size            Int             @default(0)
  nomades              String?         @db.LongText
  // JSON: string[]
  bitrix_sync          Boolean         @default(false)
  portfolio_permission Boolean         @default(false)
  overdue              Boolean         @default(false)
  from_lead            Boolean         @default(false)
  billing_day          Int?
  billing_start_date   String?
  start_date           DateTime?
  end_date             DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  // Arquivamento (Lote reunião 2026-08: "Arquivar Projetos") — soft state,
  // nunca exclusão física. archived_at != null é a única fonte de verdade
  // de "está arquivado"; status (acima) não é reaproveitado pra isso, pois
  // já tem "cancelled"/"completed" com significado próprio e distinto.
  archived_at          DateTime?
  archive_reason       String?         @db.Text
  archived_by_user_id  String?
  archived_by          User?           @relation("ProjectArchivedBy", fields: [archived_by_user_id], references: [id], onDelete: SetNull)

  // ── Admin responsável da Allka (ata 2026-08, reparo "categoria sem
  // efeito") — escolhido explicitamente no projeto, nunca inferido do dono
  // da Company/Agency nem de qualquer Admin global. Tarefas e etapas deste
  // projeto herdam este destinatário pra categoria "admin_responsavel" do
  // motor de alertas (ver alert-engine.ts). Opcional — projeto antigo/sem
  // escolha explícita fica nulo, sem escolher substituto automático.
  admin_responsible_user_id String?
  admin_responsible         User?     @relation("ProjectAdminResponsible", fields: [admin_responsible_user_id], references: [id], onDelete: SetNull)

  task_executions TaskExecution[]
  invoices        Invoice[]
  products        ProjectProduct[]
  project_tasks   ProjectTask[]
  payments        Payment[]
  credentials     ProjectCredential[]
  attachments     ProjectAttachment[]
  connections     ProjectConnection[]
  iallka_session  IallkaSession?
  planner_cards   PlannerCard[]

  // ── Rastreio da plataforma antiga ─────────────────────────────────────
  // id numérico do registro equivalente no dump legado (Dump20260423.sql).
  // Só preenchido em registros importados por scripts/import-legacy-*;
  // serve pra consultar a origem e pra tornar a importação idempotente.
  // Nunca usar em FK ou lookup técnico — o id real continua sendo o `id`.
  legacy_id        Int? @unique
  // clientId da plataforma antiga — Project não tem FK pra Client no modelo
  // novo, então o vínculo do projeto importado com seu cliente fica aqui.
  legacy_client_id Int?

  @@index([created_by_user_id])
  @@index([archived_by_user_id])
  @@index([archived_at])
  @@index([admin_responsible_user_id])
  @@map("projects")
}

// ─── PlannerColumn / PlannerCard — quadro do Planejador (Admin → Projetos,
// ata 2026-08-24). Entidade própria, NÃO um Project: os 7 cards de exemplo
// do mock antigo tinham colunas genéricas de kanban (Backlog/A Fazer/Em
// Andamento/Em Revisão/Concluído) sem relação com o `status`/`lifecycle`
// reais de Project, e um `projectId: number` que nunca chegou a apontar
// pra um `Project.id` de verdade (que é String/cuid) — nunca foi uma view
// de Project, sempre foi uma entidade solta. `project_id` abaixo é só um
// vínculo leve e opcional ("este card se refere a este projeto"), sem
// herdar nada do ciclo de vida do Project — não confundir com uma segunda
// tabela de projetos.
//
// Quadro é pessoal (owner_user_id): cada usuário só vê/edita o próprio,
// sem visão de equipe compartilhada neste lote (fora de escopo — ver
// relatório de fechamento). Arquivamento lógico (archived_at) em vez de
// exclusão física, pra deixar a estrutura pronta pra uma tela de
// restauração futura sem precisar de nova migration.
//
// `column_id` nullable + `onDelete: SetNull` (lote da tela de arquivados,
// ata 2026-08-24): antes era obrigatório + `Cascade`, o que significava
// que excluir uma coluna com cards ARQUIVADOS destruiria esses cards
// junto (o endpoint de exclusão de coluna só bloqueia por cards ATIVOS) —
// contradizia a garantia de "arquivar não é apagar". Agora a coluna pode
// sumir e o card arquivado sobrevive com `column_id: null`; a restauração
// cai pro Backlog/coluna padrão nesse caso (ver GET/POST .../restore em
// routes/planner.ts).
model PlannerColumn {
  id            String   @id @default(cuid())
  owner_user_id String
  owner         User     @relation(fields: [owner_user_id], references: [id], onDelete: Cascade)
  label         String
  color         String   @default("bg-slate-500")
  position      Int      @default(0)
  // Marca a coluna principal (Backlog) por identidade, não por texto do
  // `label` (lote de exclusão de coluna, ata 2026-08-24): o título é
  // editável pelo usuário, então confiar em `label === "Backlog"` pra
  // proteger contra exclusão seria furável só renomeando a coluna. Setada
  // uma única vez em `ensureDefaultColumns()`, nunca exposta pro payload
  // de criação/edição — não pode ser ligada/desligada pela API.
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  cards PlannerCard[]

  @@index([owner_user_id])
  @@map("planner_columns")
}

model PlannerCard {
  id            String        @id @default(cuid())
  owner_user_id String
  owner         User          @relation(fields: [owner_user_id], references: [id], onDelete: Cascade)
  column_id     String?
  column        PlannerColumn? @relation(fields: [column_id], references: [id], onDelete: SetNull)
  title         String
  description   String?       @db.LongText
  priority      String        @default("medium")
  // low | medium | high | urgent
  due_date      DateTime?
  project_id    String?
  project       Project?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  position      Int           @default(0)
  archived_at   DateTime?
  // Quem editou por último (pode divergir do owner_user_id — ex.: um admin
  // master corrigindo o card de outro admin). Nunca confiado do payload:
  // sempre resolvido do token no backend, igual created_by_user_id em Project.
  updated_by_user_id String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([owner_user_id])
  @@index([column_id])
  @@index([project_id])
  @@map("planner_cards")
}

// ─── EntitySequence — contador atômico e seguro para códigos sequenciais ────
// Usado para gerar project_code (proj_00001) e ProjectTask.task_code
// (T000001) sem depender de SELECT MAX()+1 nem de ranking de consulta.
// O incremento é feito via UPDATE ... SET current_value = LAST_INSERT_ID(
// current_value + 1) dentro da transação chamadora — idioma padrão do MySQL
// para sequências customizadas, atômico sob concorrência (ver
// src/lib/sequence.ts).
model EntitySequence {
  id            String   @id @default(cuid())
  key           String   @unique
  current_value Int      @default(0)
  updated_at    DateTime @updatedAt

  @@map("entity_sequences")
}

model Specialty {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.LongText
  hourly_rate     Float    @default(0)
  category        String
  required_skills String?  @db.LongText
  // JSON: string[]
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  task_templates TaskTemplate[]

  @@map("specialties")
}

model TaskTemplate {
  id                   String     @id @default(cuid())
  name                 String
  description          String?    @db.LongText
  specialty_id         String?
  specialty            Specialty? @relation(fields: [specialty_id], references: [id])
  base_price           Float      @default(0)
  complexity           String     @default("basic")
  // basic | intermediate | advanced | premium
  category             String?
  tags                 String?    @db.LongText
  // JSON: string[]
  estimated_hours      Float      @default(1)
  profit_margin        Float      @default(30)
  emergency_multiplier Float      @default(1.5)
  is_active            Boolean    @default(true)
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt

  executions TaskExecution[]

  @@map("task_templates")
}

model TaskExecution {
  id           String        @id @default(cuid())
  project_id   String?
  project      Project?      @relation(fields: [project_id], references: [id])
  template_id  String?
  template     TaskTemplate? @relation(fields: [template_id], references: [id])
  nomade_id    String?
  nomade       Nomade?       @relation(fields: [nomade_id], references: [id])
  title        String
  description  String?       @db.LongText
  status       String        @default("draft")
  // draft | launched | in_progress | returned | paused | agency_approval | client_approval | approved | rejected | expired
  priority     String        @default("medium")
  // low | medium | high | urgent
  type         String        @default("standard")
  // standard | qualification | learning
  due_date     DateTime?
  delivered_at DateTime?
  approved_at  DateTime?
  rating       Float?
  feedback     String?       @db.LongText
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  @@map("task_executions")
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id                      String   @id @default(cuid())
  // Código público sequencial exibido na UI e usado na URL (formato
  // "prod_1", "prod_2"...), mesmo padrão do "user_N"/"emp_N" — ver
  // src/lib/product-code.ts. Nunca usar no lugar de `id` (FK/lookup
  // técnico) — é só para exibição/URL amigável.
  product_code            String?  @unique
  name                    String
  description             String?  @db.LongText
  // Sem @db.VarChar explícito, o Prisma aplicava o padrão de 191 chars pro
  // MySQL — curto demais pro conteúdo real (ex.: PA0003 tem 251 chars, texto
  // legítimo, não lixo de dado). Ampliado com folga; continua VarChar (não
  // Text) porque o campo é conceitualmente "curto" — só a coluna estava
  // subdimensionada. Ver migration 20260711100400_widen_short_description.
  // Produtos importados de bases antigas trazem "resumo" real com mais de
  // 500 chars (ex.: 549 chars, texto legítimo) — VarChar(500) ainda
  // estourava. Trocado pra LongText (sem teto) — ver migration
  // widen_short_description_longtext.
  short_description       String?  @db.LongText
  category                String
  tags                    String?  @db.LongText
  // JSON: string[]
  base_price              Float    @default(0)
  complexity              String   @default("basic")
  // basic | intermediate | advanced | premium
  visibility              String   @default("{\"company\":true,\"agency\":true,\"partner\":false,\"inHouse\":false}")
  // JSON: ProductVisibility
  image                   String?  @db.LongText
  demonstrations          String?  @db.LongText
  // JSON: string[]
  contract_count          Int      @default(0)
  average_rating          Float    @default(0)
  completion_time         String?
  is_active               Boolean  @default(true)
  // Se as tarefas geradas por este produto precisam do aceite do cliente
  // depois do aceite da agência. Regra do produto, não do projeto: é o tipo
  // de entrega que determina se o cliente confere (identidade visual, sim;
  // publicação de post recorrente, normalmente não).
  //
  // Copiado para `ProjectTask.exige_aprovacao_cliente` na geração — a tarefa
  // guarda o valor vigente na contratação, para que mudar o produto depois
  // não altere o que já foi vendido. Ver src/lib/generate-tasks.ts.
  exige_aprovacao_cliente Boolean  @default(true)
  metadata                String?  @db.LongText
  // JSON: extras do frontend (tasks, recurrence, summaryDescription, pricing calc, etc.)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  variations       ProductVariation[]
  addons           ProductAddon[]
  task_links       ProductCatalogTask[]
  project_products ProjectProduct[]
  project_tasks    ProjectTask[]
  payment_items    PaymentItem[]
  versions         ProductVersion[]
  bundle_items     ProductBundleItem[]

  // ── Rastreio da plataforma antiga ─────────────────────────────────────
  // id numérico do registro equivalente no dump legado (Dump20260423.sql).
  // Só preenchido em registros importados por scripts/import-legacy-*;
  // serve pra consultar a origem e pra tornar a importação idempotente.
  // Nunca usar em FK ou lookup técnico — o id real continua sendo o `id`.
  legacy_id Int? @unique

  @@map("products")
}

// Snapshot automático do estado do produto tirado ANTES de cada salvamento
// (ver PUT /api/products/:id) — permite reverter pra uma versão anterior.
// `snapshot` guarda os campos do Product + variations/addons daquele
// momento, serializados em JSON (não normalizado — é só um histórico,
// não precisa ser consultável por campo).
model ProductVersion {
  id         String   @id @default(cuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  snapshot   String   @db.LongText
  created_at DateTime @default(now())

  @@index([product_id])
  @@map("product_versions")
}

model ProductVariation {
  id                String    @id @default(cuid())
  product_id        String
  product           Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  name              String
  // ex: "Até 2 campanhas"
  description       String?   @db.LongText
  // descrição complementar da variação
  price             Float     @default(0)
  // preço absoluto desta variação
  price_modifier    Float     @default(0)
  // modificador relativo sobre o preço base (legado/alternativo)
  deadline_days     Int?
  // prazo de entrega em dias corridos
  scope_description String?   @db.LongText
  // descrição do escopo/quantidade desta variação
  features          String?   @db.LongText
  // JSON: string[] — bullet points do que inclui/muda nesta variação
  sort_order        Int       @default(0)
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt
  // nullable: SQLite ALTER TABLE ADD COLUMN não suporta NOT NULL sem DEFAULT literal

  project_products   ProjectProduct[]
  catalog_task_links ProductCatalogTask[]
  bundle_items       ProductBundleItem[]

  @@map("product_variations")
}

// ─── ProductBundle — "combo": lista nomeada de produtos já existentes ────────
// Ao contratar, NUNCA vira uma linha própria de ProjectProduct — gera uma
// linha por produto componente (ver POST /api/product-bundles/:id/contract),
// exatamente como se cada um tivesse sido comprado avulso. Ver
// project_id_alteracoes_e_combos no plano desta sessão.

model ProductBundle {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.LongText
  category    String?
  // null = combo global (só admin cria/edita); preenchido = combo próprio
  // dessa agência (só ela + admin veem/editam). Primeiro uso desse padrão
  // "null=global, preenchido=da agência" fora de Project.
  agency_id          String?
  agency              Agency?  @relation(fields: [agency_id], references: [id], onDelete: Cascade)
  created_by_user_id String?
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  items ProductBundleItem[]

  @@index([agency_id])
  @@map("product_bundles")
}

model ProductBundleItem {
  id           String            @id @default(cuid())
  bundle_id    String
  bundle       ProductBundle     @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  product_id   String
  product      Product           @relation(fields: [product_id], references: [id])
  variation_id String?
  variation    ProductVariation? @relation(fields: [variation_id], references: [id])
  sort_order   Int               @default(0)

  @@index([bundle_id])
  @@map("product_bundle_items")
}

// ─── IallkaSession / IallkaMessage — assistente IA de montagem de projeto ────
// Chat multi-turno: a IA pergunta o que precisar até ter informação
// suficiente, propõe uma lista real de produtos/variações do catálogo, e ao
// ser aprovada gera o Project + ProjectProducts de verdade (ver
// lib/project-products-bulk.ts, origin="AI_ASSEMBLY"). Não reaproveita
// Conversation/ChatMessage (chat humano-humano, sender_id é FK obrigatória
// pra User) — é um modelo dedicado, mais simples.

model IallkaSession {
  id                 String   @id @default(cuid())
  user_id            String
  user               User     @relation(fields: [user_id], references: [id])
  // Auto-resolvido pra usuário de agência (resolveMyAgencyId) no momento da
  // criação da sessão; nulo pra admin — nesta fase a IA não pergunta
  // cliente/empresa, só produto/necessidade.
  agency_id          String?
  status             String   @default("gathering")
  // gathering | proposal | approved | cancelled
  created_project_id String?  @unique
  created_project    Project? @relation(fields: [created_project_id], references: [id])
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  messages IallkaMessage[]

  @@index([user_id])
  @@map("iallka_sessions")
}

model IallkaMessage {
  id                 String        @id @default(cuid())
  session_id         String
  session            IallkaSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  role               String
  // user | assistant
  content            String        @db.LongText
  // JSON do turno inteiro da IA (reply_text/stage/project_title/
  // selected_products) — só preenchido em role="assistant". Usado pra
  // recuperar a última proposta na hora de aprovar.
  structured_payload String?       @db.LongText
  created_at         DateTime      @default(now())

  @@index([session_id])
  @@map("iallka_messages")
}

model ProductAddon {
  id          String   @id @default(cuid())
  product_id  String
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.LongText
  price       Float    @default(0)
  category    String?
  created_at  DateTime @default(now())

  @@map("product_addons")
}

// ─── Catalog Tasks (Cadastro de Tarefas) ─────────────────────────────────────

model CatalogTask {
  id          String  @id @default(cuid())
  code        String  @unique
  // ex: "CT-001", gerado automaticamente
  name        String
  category    String
  // ex: "Design e Criação" | "Performance" | "Estratégia"
  subcategory String?
  task_type   String  @default("execution")
  // execution | review | approval | qualification | support
  description String? @db.LongText
  objective   String? @db.LongText

  // Execution config
  default_deadline_days Int?
  default_priority      String  @default("medium")
  // low | medium | high | urgent
  complexity            String  @default("basic")
  // basic | intermediate | advanced | premium
  estimated_hours       Float?
  responsible_type      String?
  // ex: "nomad" | "leader" | "internal"
  requires_access       Boolean @default(false)
  requires_briefing     Boolean @default(false)
  requires_files        Boolean @default(false)

  // Rich content (JSON fields)
  steps              String? @db.LongText
  // JSON: TaskStep[]
  checklist          String? @db.LongText
  // JSON: ChecklistItem[]
  briefing_questions String? @db.LongText
  // JSON: BriefingQuestion[]
  required_files     String? @db.LongText
  // JSON: string[]
  execution_rules    String? @db.LongText
  // JSON: string[]
  conclusion_rules   String? @db.LongText
  internal_guidance  String? @db.LongText

  // Status
  status    String  @default("ativa")
  // ativa | inativa | em_revisao
  is_active Boolean @default(true)
  notes     String? @db.LongText
  // internal observations

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // id do task_template equivalente na plataforma antiga (só em modelos
  // importados). Ver scripts/import-legacy-task-catalog.ts.
  legacy_id Int? @unique

  product_links ProductCatalogTask[]
  project_tasks ProjectTask[]

  @@map("catalog_tasks")
}

// ─── Product ↔ CatalogTask (many-to-many join) ───────────────────────────────

model ProductCatalogTask {
  id              String @id @default(cuid())
  product_id      String
  catalog_task_id String

  product      Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  catalog_task CatalogTask @relation(fields: [catalog_task_id], references: [id], onDelete: Cascade)

  // Link-specific overrides
  // Variação a que este modelo pertence. NULL = vale para qualquer variação
  // (caso do pacote de verdade, em que todos os modelos nascem juntos).
  // Preenchido nos produtos consolidados da base antiga, onde cada faixa
  // ("até 5/10/20 páginas") tinha o seu próprio modelo de tarefa.
  variation_id String?
  variation    ProductVariation? @relation(fields: [variation_id], references: [id], onDelete: SetNull)

  sort_order   Int     @default(0)
  is_mandatory Boolean @default(true)
  phase        String?
  // ex: "E01", "E02" — etapa do produto onde esta tarefa entra
  notes        String? @db.LongText
  // observação específica deste produto

  created_at DateTime @default(now())

  @@unique([product_id, catalog_task_id])
  @@map("product_catalog_tasks")
}

// ─── ProjectProduct — Product linked to a Project ────────────────────────────

model ProjectProduct {
  id           String            @id @default(cuid())
  project_id   String
  project      Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  product_id   String
  product      Product           @relation(fields: [product_id], references: [id])
  variation_id String?
  variation    ProductVariation? @relation(fields: [variation_id], references: [id])

  // Snapshot: preserves commercial history even if product is later edited
  product_name_snapshot     String
  product_code_snapshot     String?
  product_category_snapshot String
  product_price_snapshot    Float   @default(0)
  recurrence_snapshot       String?
  // avulso | mensal

  // Commercial snapshot (filled by the front-end at link time)
  preco_final_cliente_snapshot Float  @default(0)
  comissao_snapshot            Float  @default(0)
  pagador_snapshot             String @default("AGENCIA")
  // AGENCIA | CLIENTE

  // Limite de alterações grátis + taxa emergencial — congelados no momento
  // da compra a partir de Product.metadata (alteracoesIncluidas,
  // valorAlteracaoExtra, taxaEmergencialReducaoPercentual). Ver
  // PATCH /api/project-tasks/:id/reprovar e /solicitar-emergencial.
  alteracoes_incluidas_snapshot                Int   @default(3)
  valor_alteracao_extra_snapshot               Float @default(0)
  taxa_emergencial_reducao_percentual_snapshot Int   @default(50)

  // Status
  status            String    @default("PENDENTE")
  // PENDENTE | EM_EXECUCAO | CONCLUIDO | CANCELADO | TRANSFERIDO
  // TRANSFERIDO: a tarefa não usada saiu inteira pra outro projeto (ver
  // POST /api/project-tasks/:id/transfer) — nunca conta em
  // recalculateProjectValue, igual CANCELADO.
  start_date        DateTime?
  expected_end_date DateTime?

  origin String @default("VENDA")
  // VENDA | TRANSFERENCIA | COMBO | AI_ASSEMBLY — TRANSFERENCIA marca um
  // vínculo criado pela transferência de uma tarefa não usada de outro
  // projeto (já paga lá, nunca cobrar de novo aqui). COMBO marca um vínculo
  // nascido da contratação de um ProductBundle (ver POST
  // /api/product-bundles/:id/contract). AI_ASSEMBLY marca um vínculo
  // nascido de uma proposta aprovada do assistente IALLKA (ver POST
  // /api/iallka/sessions/:id/approve).

  // Agrupa as N linhas nascidas do MESMO evento de contratação de combo —
  // não aponta pro ProductBundle (que pode ser editado/apagado depois), é
  // só um id gerado na hora da compra, snapshot-safe como o resto desta
  // tabela. Nulo pra origin != "COMBO".
  origin_bundle_purchase_id   String?
  origin_bundle_name_snapshot String?

  // Rastreia qual sessão do IALLKA gerou esta linha (origin="AI_ASSEMBLY").
  // Sem FK de propósito — mesmo espírito snapshot-safe de
  // origin_bundle_purchase_id, sobrevive mesmo se a sessão for limpa depois.
  origin_ai_session_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tasks         ProjectTask[]
  credentials   ProjectCredential[]
  payment_items PaymentItem[]

  // ── Rastreio da plataforma antiga ─────────────────────────────────────
  // id numérico do registro equivalente no dump legado (Dump20260423.sql).
  // Só preenchido em registros importados por scripts/import-legacy-*;
  // serve pra consultar a origem e pra tornar a importação idempotente.
  // Nunca usar em FK ou lookup técnico — o id real continua sendo o `id`.
  legacy_id Int? @unique

  @@index([project_id])
  @@map("project_products")
}

// ─── ProjectTask — Execution task generated from a CatalogTask ───────────────

model ProjectTask {
  id                 String         @id @default(cuid())
  project_id         String
  project            Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_product_id String
  project_product    ProjectProduct @relation(fields: [project_product_id], references: [id], onDelete: Cascade)
  product_id         String
  product            Product        @relation(fields: [product_id], references: [id])
  catalog_task_id    String?
  catalog_task       CatalogTask?   @relation(fields: [catalog_task_id], references: [id])

  // Snapshots: task model data at the time of creation
  code_snapshot     String?
  name_snapshot     String
  category_snapshot String?

  // Globally unique operational task code — T000001, T000002, …
  task_code String? @unique

  // ── Origem da geração (preenchidos só em tarefas nascidas de pagamento
  // confirmado — ver src/lib/confirm-payment.ts). project_id/project_product_id/
  // product_id/catalog_task_id acima já respondem "qual projeto/produto/
  // template originou"; os campos abaixo cobrem o que ainda faltava: qual
  // pagamento e qual ciclo, e a chave que impede duplicar a mesma tarefa. ──
  origin_payment_id String?
  origin_payment    Payment? @relation("PaymentGeneratedTasks", fields: [origin_payment_id], references: [id], onDelete: SetNull)
  // paymentId:projectProductId:catalogTaskId:occurrenceIndex — impede
  // recriar a mesma tarefa do mesmo produto/pagamento/ciclo/ocorrência.
  generation_key    String?  @unique
  // Espelha Payment.billing_cycle_key no momento da geração (fica preservado
  // mesmo se o Payment for editado depois).
  billing_cycle_key String?
  // Reservado para produtos que no futuro gerem mais de uma ocorrência da
  // mesma tarefa numa única geração (ex.: "3x" do mesmo item). Sempre 0
  // nesta fase — não há hoje quantidade contratada por ProjectProduct.
  occurrence_index  Int      @default(0)

  // ── Transferência entre projetos ──────────────────────────────────────
  // Preenchidos só quando a tarefa chegou neste projeto via transferência
  // (POST /api/project-tasks/:id/transfer) em vez de ter nascido aqui.
  // origin_payment_id/generation_key acima continuam intactos e apontando
  // pro pagamento ORIGINAL — a transferência nunca reescreve histórico
  // financeiro, só reaponta onde a tarefa é executada.
  transferred_from_project_id String?
  transferred_at              DateTime?
  transferred_by_user_id      String?

  // Task fields
  title                  String
  description            String? @db.LongText
  status                 String  @default("PARA_LANCAMENTO")
  // PARA_LANCAMENTO | EM_LANCAMENTO | AGUARDANDO_INFORMACOES | LIBERADA_PARA_EXECUCAO
  // | EM_EXECUCAO | EM_REVISAO | EM_APROVACAO | CONCLUIDA | CANCELADA | AGUARDANDO_NOMADE
  priority               String  @default("medium")
  // low | medium | high | urgent
  assignee_id            String?
  responsavel_agencia_id String?
  nomade_responsavel_id  String?
  lider_responsavel_id   String?
  // User.id of the leader assigned to qualify this task

  due_date                DateTime?
  start_date              DateTime?
  completed_at            DateTime?
  data_lancamento         DateTime?
  data_liberacao_execucao DateTime?
  data_inicio_execucao    DateTime?
  data_conclusao          DateTime?
  // Prazo de 30 dias para lançar a tarefa — após esta data ela expira automaticamente
  lancamento_expires_at   DateTime?

  // ── Aprovação em dois níveis ──────────────────────────────────────────
  // Agência confere, depois o cliente. Ver src/lib/stage-engine.ts e
  // PATCH /api/project-tasks/:id/aprovar | /reprovar.
  aprovado_agencia_em     DateTime?
  aprovado_agencia_por    String?
  aprovado_cliente_em     DateTime?
  aprovado_cliente_por    String?
  reprovado_em            DateTime?
  reprovado_por           String?
  reprovacao_motivo       String?   @db.LongText
  reprovacao_nivel        String?
  // agencia | cliente
  reprovacoes             Int       @default(0)
  // Quando falso, o aceite da agência encerra a tarefa (sem etapa de cliente).
  exige_aprovacao_cliente Boolean   @default(true)

  // ── Limite de alterações grátis ─────────────────────────────────────────
  // Quantas reprovações além do limite grátis (ProjectProduct.
  // alteracoes_incluidas_snapshot) já foram pagas. Ver PATCH .../reprovar
  // (bloqueia) e PUT /api/billing/invoices/:id (destrava ao pagar).
  alteracoes_extras_pagas Int      @default(0)
  // Fatura pendente bloqueando a PRÓXIMA reprovação além do limite grátis —
  // nulo quando não há bloqueio ativo.
  pending_fee_invoice_id  String?
  pending_fee_invoice     Invoice? @relation("TaskPendingFeeInvoice", fields: [pending_fee_invoice_id], references: [id], onDelete: SetNull)

  // ── Entrega emergencial ─────────────────────────────────────────────────
  // Ver POST /api/project-tasks/:id/solicitar-emergencial. Só permitido uma
  // vez por tarefa (não bloqueia nada, mas evita comprimir o prazo/cobrar
  // 50% repetidas vezes na mesma tarefa).
  emergencial_solicitada_em      DateTime?
  emergencial_solicitada_por     String?
  emergencial_reducao_percentual Int?
  emergencial_invoice_id         String?
  emergencial_invoice            Invoice? @relation("TaskEmergencialInvoice", fields: [emergencial_invoice_id], references: [id], onDelete: SetNull)

  sort_order Int     @default(0)
  fase       String?
  // kept for backward compat
  phase      String?

  // JSON snapshots (preserve checklist/steps/briefing from model at time of creation)
  checklist_snapshot String? @db.LongText
  steps_snapshot     String? @db.LongText
  briefing_snapshot  String? @db.LongText
  observations       String? @db.LongText

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  stages             ProjectTaskStage[]
  briefing_answers   TaskBriefingAnswer[]
  attachments        TaskAttachment[]
  assignment_history TaskAssignmentHistory[]
  credentials        ProjectCredential[]
  lider_responsavel  User?                   @relation("TaskLiderResponsavel", fields: [lider_responsavel_id], references: [id])

  // ── Rastreio da plataforma antiga ─────────────────────────────────────
  // id numérico do registro equivalente no dump legado (Dump20260423.sql).
  // Só preenchido em registros importados por scripts/import-legacy-*;
  // serve pra consultar a origem e pra tornar a importação idempotente.
  // Nunca usar em FK ou lookup técnico — o id real continua sendo o `id`.
  legacy_id    Int?    @unique
  // true = tarefa que veio da plataforma antiga e continua no modelo antigo
  // (não foi possível adaptá-la ao produto/CatalogTask novo). A UI deve
  // sinalizar isso; o motor novo não deve assumir etapas/briefing dela.
  legacy_model Boolean @default(false)

  @@index([origin_payment_id])
  @@index([project_id])
  @@index([status])
  @@index([assignee_id])
  @@index([nomade_responsavel_id])
  @@index([responsavel_agencia_id])
  @@index([lider_responsavel_id])
  // Usado pelo motor de alertas automáticos (src/lib/alert-engine.ts) pra
  // varrer tarefas ativas com prazo sem full scan.
  @@index([status, due_date])
  @@map("project_tasks")
}

// ─── ProjectTaskStage ─────────────────────────────────────────────────────

model ProjectTaskStage {
  id              String      @id @default(cuid())
  project_task_id String
  project_task    ProjectTask @relation(fields: [project_task_id], references: [id], onDelete: Cascade)

  catalog_step_ref          String?
  // reference code from the source CatalogTask step JSON
  // Chave estável de origem pra etapas geradas por especificação (ver
  // src/lib/generate-tasks-from-spec.ts) — formato
  // "spec:{generationKey}:stage:{stageCode}". Permite reencontrar a MESMA
  // etapa em reexecuções (create-only, nunca apaga) sem depender do id
  // interno. Nula pras etapas do gerador genérico por catálogo, que não
  // precisam desse rastreio (idempotência já garantida por generation_key
  // na ProjectTask pai).
  source_key                String?
  titulo                    String
  descricao                 String? @db.LongText
  ordem                     Int     @default(0)
  status                    String  @default("PENDENTE")
  // PENDENTE | AGUARDANDO_EXECUTOR | EM_ANDAMENTO | CONCLUIDA | BLOQUEADA
  obrigatoria               Boolean @default(true)
  depende_da_etapa_anterior Boolean @default(true)
  briefing_necessario       Boolean @default(false)

  // ── Motor de execução por etapa ──────────────────────────────────────
  // Configuração materializada de CatalogTask.steps na geração + estado de
  // execução. Permite etapa com executor, prazo e pagamento próprios — ver
  // src/lib/stage-engine.ts e docs/motor-tarefas-legado.md.
  executor_type       String    @default("nomad")
  // nomad | leader | internal
  nomade_id           String?
  lider_id            String?
  categoria           String?
  // especialidade exigida; pode diferir da categoria da tarefa-pai
  manter_mesmo_nomade Boolean   @default(false)
  prazo_execucao      DateTime?
  prazo_aprovacao     DateTime?
  horas_execucao      Float?
  valor_nomade        Float?
  oculta_no_prazo     Boolean   @default(false)
  conta_no_prazo      Boolean   @default(true)
  exige_anexo         Boolean   @default(false)
  config_snapshot     String?   @db.LongText
  iniciada_em         DateTime?
  concluida_em        DateTime?
  concluida_por       String?
  checklist_snapshot  String?   @db.LongText
  // JSON: ChecklistItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  attachments TaskAttachment[]

  @@unique([project_task_id, source_key])
  @@map("project_task_stages")
}

// ─── TaskBriefingAnswer ──────────────────────────────────────────────────

model TaskBriefingAnswer {
  id              String      @id @default(cuid())
  project_task_id String
  project_task    ProjectTask @relation(fields: [project_task_id], references: [id], onDelete: Cascade)

  question_key  String
  // matches the key from briefing_snapshot JSON
  question_text String  @db.LongText
  answer        String? @db.LongText
  files         String? @db.LongText
  // JSON: { name, url, size, mime_type }[]
  links         String? @db.LongText
  // JSON: string[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_task_id, question_key])
  @@map("task_briefing_answers")
}

// ─── TaskAttachment ──────────────────────────────────────────────────────────

model TaskAttachment {
  id              String      @id @default(cuid())
  project_task_id String
  project_task    ProjectTask @relation(fields: [project_task_id], references: [id], onDelete: Cascade)

  type         String  @default("file")
  // file | link | reference | delivery
  name         String
  url          String  @db.LongText
  size         Int?
  // bytes
  mime_type    String? @db.LongText
  observations String? @db.LongText
  uploaded_by  String?
  // user id or name

  // Etapa a que este anexo pertence. Nulo = anexo da tarefa como um todo
  // (briefing, referências); preenchido = entrega daquela etapa, que é o que
  // satisfaz ProjectTaskStage.exige_anexo.
  project_task_stage_id String?
  project_task_stage    ProjectTaskStage? @relation(fields: [project_task_stage_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([project_task_stage_id])
  @@map("task_attachments")
}

// ─── ProjectAttachment ───────────────────────────────────────────────────────
// Documentos de CONTEXTO do projeto (PDF/DOC/imagens) — diferente de
// TaskAttachment (entrega/referência de UMA tarefa). Servem de base pra IA
// entender o cliente ao preencher briefing de tarefas, quando o usuário optar
// por isso no "Preencher com Assistente" (ver fillBriefingWithAI em
// ai-consultor.ts). Arquivo fica em disco local
// (uploads/project-documents/<project_id>/<file_name>), só o metadado aqui.
model ProjectAttachment {
  id         String  @id @default(cuid())
  project_id String
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  name        String
  // nome original mostrado ao usuário
  file_name   String
  // nome gerado em disco (evita colisão/traversal)
  mime_type   String?
  size        Int?
  uploaded_by String?

  created_at DateTime @default(now())

  @@index([project_id])
  @@map("project_attachments")
}

// ─── AIKnowledgeCategory / AIKnowledgeDocument ────────────────────────────────
// Bases de conhecimento administráveis que alimentam diferentes fluxos de IA
// (Gemini) — uma categoria por finalidade (briefing/PLAC, produtos, etc.),
// gerenciadas pelo admin em Configurações. Arquivo fica em disco local
// (uploads/knowledge-base/<category_key>/<file_name>), só o metadado aqui.
// A categoria "briefing" recebe automaticamente, na primeira subida do
// servidor, os arquivos que já existiam em instrucoesAI/ (ver
// lib/ai-knowledge-base.ts) — não perde o que já estava configurado.
model AIKnowledgeCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  // slug estável usado no código (ex: "briefing", "produtos") — não muda
  // mesmo que o nome exibido mude.
  name        String
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  documents AIKnowledgeDocument[]

  @@map("ai_knowledge_categories")
}

model AIKnowledgeDocument {
  id          String              @id @default(cuid())
  category_id String
  category    AIKnowledgeCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  name        String
  file_name   String
  mime_type   String?
  size        Int?
  uploaded_by String?

  created_at DateTime @default(now())

  @@index([category_id])
  @@map("ai_knowledge_documents")
}

// ─── AIServiceConfig / AIModelPricing / AIUsageLog ────────────────────────────
// Controle de custo de IA (admin > Configurações > "Uso e Custos de IA").
// Um AIServiceConfig por provedor plugado na plataforma (hoje só "gemini",
// desenhado pra caber outros — OpenAI, Claude — sem mudar o formato). Preço
// por modelo fica em AIModelPricing, editável pelo admin (o valor inicial é
// só uma estimativa — não existe API de billing em tempo real pela chave que
// usamos hoje, então o custo é sempre CALCULADO a partir dos tokens
// devolvidos pela própria resposta do Gemini × o preço configurado aqui, não
// puxado do Google). Cada chamada real vira uma linha em AIUsageLog, com o
// custo já calculado no momento (preço muda depois não reescreve histórico).
model AIServiceConfig {
  id                  String   @id @default(cuid())
  key                 String   @unique
  // slug estável ("gemini") — não muda mesmo que o nome de exibição mude.
  name                String
  provider            String?
  monthly_budget_usd  Float?
  // teto mensal opcional; null = sem teto configurado (só acompanha o gasto).
  alert_threshold_pct Int      @default(80)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  model_pricing AIModelPricing[]
  usage_logs    AIUsageLog[]

  @@map("ai_service_configs")
}

model AIModelPricing {
  id         String          @id @default(cuid())
  service_id String
  service    AIServiceConfig @relation(fields: [service_id], references: [id], onDelete: Cascade)

  model                    String
  // Como este modelo é cobrado — nem toda IA cobra por token: geração de
  // imagem/vídeo costuma ser por unidade. "tokens" usa os dois campos por
  // milhão abaixo; qualquer outro valor usa `unit_price` (preço de UMA
  // unidade — 1 imagem, 1 segundo de vídeo, 1 chamada, o que fizer sentido
  // pro provedor).
  pricing_unit             String @default("tokens")
  // "tokens" | "image" | "video_second" | "request" | "minute"
  input_price_per_million  Float?
  // preço em `currency` por 1.000.000 de tokens de entrada (só pricing_unit = "tokens")
  output_price_per_million Float?
  // preço em `currency` por 1.000.000 de tokens de saída, inclui "thinking" (só pricing_unit = "tokens")
  unit_price               Float?
  // preço em `currency` por 1 unidade (pricing_unit != "tokens")
  currency                 String @default("USD")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([service_id, model])
  @@map("ai_model_pricing")
}

model AIUsageLog {
  id         String          @id @default(cuid())
  service_id String
  service    AIServiceConfig @relation(fields: [service_id], references: [id], onDelete: Cascade)

  model              String
  feature            String
  // qual fluxo chamou: "fill-briefing" | "improve-answer" |
  // "improve-product-field" | "research-product-pricing" | ...
  prompt_tokens      Int     @default(0)
  completion_tokens  Int     @default(0)
  total_tokens       Int     @default(0)
  units              Int     @default(0)
  // usado quando o modelo é cobrado por unidade (pricing_unit != "tokens") —
  // ex: 1 imagem gerada, 30 (segundos) de vídeo.
  estimated_cost_usd Float   @default(0)
  user_id            String?

  created_at DateTime @default(now())

  @@index([service_id])
  @@index([created_at])
  @@map("ai_usage_logs")
}

// ─── TaskAssignmentHistory ────────────────────────────────────────────────────

model TaskAssignmentHistory {
  id              String      @id @default(cuid())
  project_task_id String
  project_task    ProjectTask @relation(fields: [project_task_id], references: [id], onDelete: Cascade)

  nomade_id   String?
  // null when no nomad was found
  criterio    String
  // "nota_media" | "manual"
  nota_nomade Float?
  automatico  Boolean @default(true)
  resultado   String
  // "atribuido" | "sem_nomade_disponivel"
  detalhes    String? @db.LongText
  // JSON: extra info (eligible candidates, rejection reason, etc.)

  created_at DateTime @default(now())

  @@map("task_assignment_history")
}

// ─── SystemAlert ──────────────────────────────────────────────────────────────

// ─── Motor de alertas automáticos (ata 2026-08, 2º lote) ────────────────────
// Padrão → Regra → Verificação automática → Ocorrência (SystemAlert). Um
// Padrão define conteúdo/aparência (reaproveitável), uma Regra define quando
// disparar (usa um Padrão), e cada disparo real vira um SystemAlert comum —
// não há tabela paralela de "ocorrências". Ver src/lib/alert-engine.ts.
model AlertStandard {
  id         String   @id @default(cuid())
  // Chave estável — nunca editável pela interface, é o que a Regra e o motor
  // usam para reconhecer o padrão (ex.: "task.due_soon", "task.overdue").
  key        String   @unique
  name       String
  // Título/mensagem-modelo, com variáveis entre chaves duplas — ver
  // `allowed_variables_json` (lista fechada; nunca código executável).
  title      String
  message    String   @db.LongText
  default_severity String @default("warning")
  // "info" | "warning" | "error"
  is_active  Boolean  @default(true)
  // Padrão nascido do bootstrap do sistema (task.due_soon/task.overdue) —
  // não pode ser excluído fisicamente, só desativado.
  is_system  Boolean  @default(false)
  // JSON array de strings — nomes de variáveis aceitas na mensagem deste
  // padrão (ex.: ["tarefa","prazo","projeto"]). Validado no backend a cada
  // gravação; nunca interpretado como código.
  allowed_variables_json String @db.LongText
  // Imagem opcional do padrão (ata 2026-08, 4º lote) — nome físico gerado
  // (nunca o nome enviado pelo usuário), servido via rota autenticada, nunca
  // caminho no disco aceito do cliente. Quando uma ocorrência é criada a
  // partir deste padrão, o arquivo é COPIADO fisicamente pra um nome novo e
  // gravado na própria ocorrência — nunca uma referência viva a este campo
  // — pra que substituir/remover a imagem do padrão depois nunca quebre uma
  // ocorrência histórica.
  image_file_name String?
  // Obrigatório sempre que image_file_name estiver preenchido — validado no
  // backend, nunca só no frontend.
  image_alt       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id String?
  updated_by_id String?

  rules AlertRule[]
  alerts SystemAlert[]

  @@map("alert_standards")
}

model AlertRule {
  id         String        @id @default(cuid())
  standard_id String
  standard   AlertStandard @relation(fields: [standard_id], references: [id])
  name       String
  // Único construtor aceito nesta fase — não é um DSL genérico:
  // "task.due_soon" | "task.overdue" | "stage.due_soon" | "stage.overdue".
  trigger_type String
  is_active  Boolean       @default(true)
  // Antecedência em minutos (só usado por gatilhos "due_soon").
  lead_time_minutes Int?
  // Sobrescreve a criticidade padrão do Padrão, quando preenchido.
  severity_override String?
  // JSON com parâmetros seguros do gatilho (ex.: {}) — nunca código/SQL.
  // Reservado para parâmetros futuros deste mesmo conjunto fechado de
  // gatilhos; validado com allowlist no backend.
  config_json String?      @db.LongText
  // JSON array de categorias de destinatário (papéis/relações, nunca IDs de
  // usuário individuais) — ex.: ["responsavel","nomade"]. A regra continua
  // única e geral; o motor resolve a pessoa real de cada categoria pra cada
  // registro elegível no momento da execução. Ver ALERT_RECIPIENT_CATEGORIES
  // em alert-engine.ts.
  recipient_roles_json String @db.LongText

  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  created_by_id String?
  updated_by_id String?

  alerts SystemAlert[]

  @@index([standard_id])
  @@index([trigger_type])
  @@map("alert_rules")
}

model SystemAlert {
  id          String    @id @default(cuid())
  type        String
  // "nomade_nao_encontrado" | "tarefa_atrasada" | etc.
  title       String
  message     String    @db.LongText
  severity    String    @default("warning")
  // "info" | "warning" | "error"
  category    String    @default("notificacao")
  // "notificacao" (informativo, sem ação exigida) | "alerta" (precisa de
  // decisão/prioridade) — separa a aba Notificações da aba Alertas no sino
  // do header, que hoje mostravam exatamente o mesmo feed sem distinção.
  entity_type String?
  // "project_task" | "project_task_stage" | "project" | etc.
  entity_id   String?
  // "Pai" navegável, só usado quando entity_id sozinho não é suficiente pra
  // montar o destino do botão "Ver" (ata 2026-08, reparo "Ver alerta"): pra
  // entity_type="project_task_stage", entity_id é o id da ETAPA e este
  // campo é o id da TAREFA que contém a etapa — a plataforma não tem rota
  // exclusiva de etapa, então "Ver" abre a tarefa. Nulo pros demais tipos
  // (entity_id já é suficiente, ou não existe destino nenhum). Nunca usado
  // pra nada além de montar o link — não afeta dedupe/regra/resolução.
  entity_parent_id String?
  // Destinatário. Nulo = alerta geral do sistema (comportamento original,
  // visível ao Admin); preenchido = aviso de uma pessoa só, como "a etapa X
  // abriu para você".
  user_id     String?
  // Para onde a pessoa deve ir ao clicar (ex.: /nomades/minhastarefas).
  action_url  String?
  is_read     Boolean   @default(false)
  read_at     DateTime?
  // Arquivado = usuário já tratou/não precisa mais ver por padrão, mas o
  // dado continua existindo (nunca é hard-delete) — diferente de is_read,
  // que só marca "já vi": dá pra ler e continuar precisando resolver.
  is_archived Boolean   @default(false)
  archived_at DateTime?
  created_at  DateTime  @default(now())

  // De qual mensagem de notificacao este alerta nasceu, quando veio de um
  // envio da tela /admin/notifications. Nulo nos alertas do proprio sistema
  // (motor de etapas, avisos automaticos). E o que forma o historico de
  // envios, sem tabela paralela.
  notification_message_id String?
  notification_message    NotificationMessage? @relation(fields: [notification_message_id], references: [id], onDelete: SetNull)

  // ── Motor automático (ata 2026-08, 2º lote) — todos opcionais/nulos em
  // registros antigos, que continuam funcionando sem eles. ──────────────
  standard_id      String?
  standard         AlertStandard? @relation(fields: [standard_id], references: [id])
  rule_id          String?
  rule             AlertRule?     @relation(fields: [rule_id], references: [id])
  // Chave determinística regra+tipo_entidade+entidade+destinatário+prazo
  // (ex.: "ruleId:project_task_stage:stageId:userId:2026-08-30") — única
  // por linha ATIVA (constraint de banco, não só trava em memória; protege
  // mesmo com mais de uma instância do backend). Zerada em registros já
  // resolvidos (ver migration) pra não colidir com um ciclo futuro que
  // reaproveite o mesmo prazo depois de resolvido.
  dedupe_key       String?        @unique
  resolved_at      DateTime?
  // "condition_cleared" | "task_completed" | "task_cancelled" | "superseded"
  // | "expired" — motivo controlado, nunca texto livre do administrador.
  resolution_reason String?

  // ── Imagem, expiração e Programados (ata 2026-08, 4º lote) ─────────────
  // Snapshot próprio da ocorrência — nunca uma referência viva ao Padrão
  // (ver comentário em AlertStandard.image_file_name). Alerta Avulso com
  // imagem também usa este mesmo par de campos, upload direto.
  image_file_name String?
  image_alt       String?
  // Expiração da OCORRÊNCIA (distinta do fim da programação, que é
  // AlertSchedule.ends_at — depois dele a programação para de CRIAR novas
  // ocorrências; isto aqui é sobre UMA ocorrência já criada deixar de ser
  // "ativa"). Nulo = nunca expira sozinha. Só usado por Avulsos e
  // Programados — o motor nunca aplica isto a ocorrências de Regra de
  // tarefa/etapa (elas não têm este campo preenchido).
  expires_at       DateTime?
  schedule_id      String?
  schedule         AlertSchedule? @relation(fields: [schedule_id], references: [id])

  // ── Visualização detalhada e histórico (ata 2026-08, 8º lote) ───────────
  // Quem criou manualmente (Avulso, POST /admin) — nulo em qualquer origem
  // automática (regra/padrão/programado/motor) e também nulo em Avulsos
  // criados ANTES deste lote (nunca inferido por backfill; a interface
  // simplesmente não mostra "responsável pela criação" quando isto é nulo).
  created_by_user_id String?
  events             SystemAlertEvent[]

  // ── Resolução formal de alerta crítico (ata 2026-08, 10º lote) ──────────
  // Campos NOVOS e DISTINTOS de resolved_at/resolution_reason acima —
  // aqueles são do motor automático (regra/padrão, expiração; nunca texto
  // livre, nunca autor humano) e continuam intocados, com seu próprio
  // significado (dedupe_key zerado, permite um ciclo futuro reabrir a
  // condição). Isto aqui é a resolução MANUAL de um alerta vermelho/crítico
  // pelo destinatário/admin autorizado — histórico permanente, nunca
  // reaproveitado como sinônimo de "expirado" ou "arquivado". Auditoria
  // prévia confirmou que reaproveitar resolved_at/resolution_reason
  // conflitaria com a semântica já estabelecida do motor (um alerta
  // expirado passava a aparecer como "resolvido" no detalhe — bug real
  // encontrado e corrigido neste lote).
  manual_resolved_at DateTime?
  resolved_by_user_id String?
  // "correcao_aplicada" | "responsavel_acionado" | "processo_ajustado" |
  // "falso_positivo" | "outra_acao" — enumeração fechada, nunca texto
  // livre pra este campo (a explicação vai em resolution_description).
  resolution_action String?
  resolution_description String? @db.Text
  // Idempotência da resolução (mesmo padrão de SystemAlertEvent.client_event_id
  // — ata 2026-08, 9º lote): gerado no frontend por clique intencional em
  // "Confirmar resolução", único no banco. Retry/corrida com o MESMO valor
  // nunca cria uma segunda resolução nem sobrescreve a original.
  resolution_client_action_id String? @unique

  // ── Resolução AUTOMÁTICA de ocorrência de TAREFA (ata 2026-08, bloco 1/2
  // "resolução automática de alertas de tarefa") ────────────────────────────
  // A condição real que criou o alerta (tarefa próxima do prazo / tarefa
  // atrasada) deixou de existir. Campos NOVOS e distintos dos dois pares
  // acima — nunca conflatados:
  //   - `resolved_at`/`resolution_reason`  = motor legado de etapas + EXPIRAÇÃO
  //     (Avulso/Programado). Continua sendo o campo da expiração; a interface
  //     nunca deve apresentar expiração como resolução automática.
  //   - `manual_resolved_at`/`resolution_*` = resolução HUMANA formal.
  // Só o motor grava estes campos — não existe rota pública que aceite
  // "resolver automaticamente". Nunca sobrescreve uma resolução manual já
  // gravada.
  automatic_resolved_at DateTime?
  // Enum fechado no código (AUTO_RESOLUTION_REASON_MESSAGES em
  // alert-engine.ts): task_completed | task_cancelled | task_removed |
  // deadline_changed_not_overdue | deadline_out_of_window | deadline_changed |
  // superseded_by_overdue | recipient_changed | rule_disabled. Nunca texto livre.
  automatic_resolution_reason String?
  // Mensagem legível (pt-BR) derivada do motivo — gerada no servidor.
  automatic_resolution_message String? @db.Text
  // Fim do EPISÓDIO da condição (regra+tarefa+destinatário). Gravado pelo
  // motor quando a condição termina, MESMO que o alerta já tenha sido
  // resolvido manualmente antes disso. Enquanto uma ocorrência está "no
  // episódio" ela mantém `dedupe_key`; ao encerrar, o motor zera `dedupe_key`
  // e grava aqui. É o que impede a recriação a cada ciclo depois de uma
  // resolução manual e o que libera um episódio novo quando a condição volta.
  condition_cleared_at DateTime?

  @@index([user_id, is_read])
  @@index([user_id, is_archived])
  @@index([user_id, category, is_read])
  @@index([notification_message_id])
  @@index([rule_id])
  @@index([standard_id])
  @@index([schedule_id])
  @@index([expires_at])
  @@index([automatic_resolved_at])
  @@map("system_alerts")
}

// ─── SystemAlertEvent ───────────────────────────────────────────────────────
// Linha do tempo real de UMA ocorrência de alerta (ata 2026-08, 8º lote —
// "visualização detalhada e histórico real"). Auditado antes de criar: a
// única estrutura de auditoria existente (ProductFeedbackAccessAudit, via
// writeAccessAudit) é genérica, sem índice por alerta, pensada só pra ações
// ADMINISTRATIVAS da Central (criar/editar/reclassificar/arquivar Avulso) —
// nunca cobriu ações do destinatário (abrir detalhes, clicar em Ver origem,
// dispensar) nem é praticamente consultável "todos os eventos do alerta X"
// sem varrer texto. Por isso uma tabela própria, imutável (nunca
// UPDATE/DELETE por esta feature — só INSERT), com o mínimo necessário.
model SystemAlertEvent {
  id       String      @id @default(cuid())
  alert_id String
  alert    SystemAlert @relation(fields: [alert_id], references: [id], onDelete: Cascade)

  // "created" | "details_opened" | "origin_clicked" | "archived" |
  // "unarchived" | "dismissed" | "expired_by_engine" | "admin_updated"
  event_type String

  // Quem realizou a ação — nulo pra eventos do motor (criação automática,
  // expiração). Escalar solto (mesmo padrão de SystemAlert.user_id): não
  // precisa de FK Prisma pra isto ser útil, e evita mais uma relação sem
  // `onDelete` definido de propósito.
  actor_user_id String?

  // Texto legível gerado no SERVIDOR (nunca no frontend, nunca digitado
  // por humano) — o que aparece na linha do tempo.
  description String @db.Text

  // Metadados mínimos e seguros (ex.: severidade antiga/nova numa
  // reclassificação). Nunca token, cookie, senha, URL assinada ou payload
  // completo da requisição.
  metadata_json String? @db.Text

  // Idempotência de eventos de visualização (ata 2026-08, 9º lote —
  // "details_opened"/"origin_clicked", os únicos gravados a partir de uma
  // ação do CLIENTE, não de uma mudança de estado no servidor). Gerado no
  // frontend por ação intencional (uma abertura do painel, um clique) e
  // protegido por índice único de verdade — nunca só um `useRef` do lado
  // do cliente, que não sobrevive a Strict Mode/efeitos concorrentes/
  // retry de rede. Nulo nos demais eventos (criados/arquivados/etc.),
  // todos originados de uma mudança de estado já idempotente por natureza
  // (guardada por `is_archived`/`is_read` antes de gravar — ver
  // system-alerts.ts). Mesmo padrão de SystemAlert.dedupe_key.
  client_event_id String? @unique

  created_at DateTime @default(now())

  @@index([alert_id, created_at])
  @@map("system_alert_events")
}

// ─── AlertSchedule ──────────────────────────────────────────────────────────
// Alerta Programado (ata 2026-08, 4º lote) — estrutura própria e explícita
// (nunca cron livre digitado pelo Admin). Cada disparo vira um SystemAlert
// comum (ver SystemAlert.schedule_id) — não existe tabela paralela de
// "ocorrência de programação".
model AlertSchedule {
  id      String  @id @default(cuid())
  // Nome administrativo — nunca aparece pro destinatário.
  name    String
  title   String
  message String  @db.LongText
  severity String @default("warning")
  // "info" | "warning" | "error"
  image_file_name String?
  image_alt       String?
  // Nulo = alerta Geral (mesmo significado já usado em Avulsos); preenchido
  // = um usuário específico. Nunca grupo — fora de escopo deste lote.
  user_id String?

  // "once" | "daily" | "weekly"
  recurrence_type String
  // JSON array de inteiros 0-6 (0=domingo), só relevante quando
  // recurrence_type === "weekly".
  weekdays_json   String? @db.LongText
  // "HH:MM" em 24h, no horário local do campo `timezone` abaixo — nunca
  // interpretado no horário do servidor.
  time_of_day     String
  // IANA (ex.: "America/Sao_Paulo") — nunca inferido do servidor.
  timezone        String  @default("America/Sao_Paulo")
  // Para "once": o instante exato do envio, já resolvido em UTC no momento
  // da criação (a partir de data+hora+timezone informados). Para
  // daily/weekly: a partir de quando a programação passa a valer.
  starts_at DateTime
  // Fim da PROGRAMAÇÃO — depois desta data, nenhuma ocorrência nova é
  // criada (distinto de SystemAlert.expires_at, que é sobre uma ocorrência
  // já criada). Nulo = sem data de término.
  ends_at   DateTime?
  // Expiração aplicada a CADA ocorrência criada por esta programação
  // (minutos após a criação) — copiado pro SystemAlert.expires_at de cada
  // disparo. Nulo = ocorrências desta programação não expiram sozinhas.
  occurrence_expires_minutes Int?

  is_active   Boolean   @default(true)
  is_archived Boolean   @default(false)
  archived_at DateTime?

  last_run_at DateTime?
  // Próximo instante (UTC) em que esta programação deve disparar — nulo
  // quando não há próxima execução (programação "once" já disparada, ou
  // passou de `ends_at`). Recalculado a cada execução e a cada edição de
  // horário/dias/timezone.
  next_run_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id String?
  updated_by_id String?

  alerts SystemAlert[]

  @@index([is_active, next_run_at])
  @@map("alert_schedules")
}

// ─── Notificacoes ─────────────────────────────────────────────────────────────
//
// A tela /admin/notifications oferecia cinco canais (email, whatsapp, popup,
// banner, push) e nenhum deles existe no backend. O canal que funciona e o
// aviso dentro da plataforma (SystemAlert). Ver a migration
// 20260808020000_notificacoes.

model NotificationMessage {
  id         String   @id @default(cuid())
  name       String
  title      String
  content    String   @db.LongText
  is_active  Boolean  @default(true)
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rules  NotificationRule[]
  alerts SystemAlert[]

  @@index([is_active])
  @@map("notification_messages")
}

model NotificationRule {
  id                   String              @id @default(cuid())
  message_id           String
  message              NotificationMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  name                 String
  is_active            Boolean             @default(true)
  // Publico-alvo: listas de account_type e de role. Vazias = todos.
  target_account_types Json?
  target_roles         Json?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  @@index([message_id])
  @@map("notification_rules")
}

// Preferência PESSOAL de um usuário: para um tipo de evento (catálogo fixo
// no frontend, components/notification-preferences-panel.tsx PREF_GROUPS —
// event_type é livre aqui, mesma liberdade que SystemAlert.type já tem),
// por qual canal ele quer ser avisado. Uma linha por (usuário, evento,
// canal). Unifica o que antes eram duas telas mockadas separadas
// ("Preferências" e "Regras") — mesma tabela, duas visualizações.
//
// Só o canal "in_app" entrega de verdade hoje (vira SystemAlert). email/
// whatsapp/push ficam salvos aqui pra quando existir envio real — nunca
// prometer no frontend que eles já disparam.
model NotificationPreference {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event_type String
  channel    String
  // "in_app" | "email" | "whatsapp" | "push"
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, event_type, channel])
  @@index([user_id])
  @@map("notification_preferences")
}

// Grupo pessoal de pessoas do próprio time do usuário (ex.: "Líderes de
// Projeto", "Equipe Financeira") — só o cadastro/gestão do grupo em si.
// Usar um grupo como alvo de uma regra/notificação de verdade é uma etapa
// futura, ainda não conectada aqui.
model NotificationGroup {
  id            String   @id @default(cuid())
  owner_user_id String
  owner         User     @relation("NotificationGroupOwner", fields: [owner_user_id], references: [id], onDelete: Cascade)
  name          String
  description   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  members NotificationGroupMember[]

  @@index([owner_user_id])
  @@map("notification_groups")
}

model NotificationGroupMember {
  id         String            @id @default(cuid())
  group_id   String
  group      NotificationGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User              @relation("NotificationGroupMemberUser", fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime          @default(now())

  @@unique([group_id, user_id])
  @@index([user_id])
  @@map("notification_group_members")
}

// ─── Financial ────────────────────────────────────────────────────────────────

model Invoice {
  id             String    @id @default(cuid())
  company_id     String?
  company        Company?  @relation(fields: [company_id], references: [id])
  project_id     String?
  project        Project?  @relation(fields: [project_id], references: [id])
  amount         Float
  status         String    @default("pending")
  // pending | paid | overdue | cancelled
  due_date       DateTime?
  paid_at        DateTime?
  description    String?   @db.LongText
  invoice_number String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Inverso de ProjectTask.pending_fee_invoice/emergencial_invoice — não
  // navegado hoje (o lookup é sempre feito por pending_fee_invoice_id no
  // findFirst do lado da tarefa), mas Prisma exige o campo espelhado.
  blocking_tasks    ProjectTask[] @relation("TaskPendingFeeInvoice")
  emergencial_tasks ProjectTask[] @relation("TaskEmergencialInvoice")

  @@map("invoices")
}

model WithdrawalRequest {
  id            String    @id @default(cuid())
  nomade_id     String
  nomade        Nomade    @relation(fields: [nomade_id], references: [id])
  amount        Float
  status        String    @default("aguardando_analise")
  // aguardando_analise | pagamento_agendado | pagamento_efetuado | cancelado | reprovado
  pix_key       String?
  pix_key_type  String?
  // cpf | email | phone | random
  notes         String?   @db.LongText
  reviewed_by   String?
  reviewed_at   DateTime?
  scheduled_for DateTime?
  paid_at       DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("withdrawal_requests")
}

// ─── Terms ────────────────────────────────────────────────────────────────────

model Term {
  id                   String   @id @default(cuid())
  title                String
  content              String   @db.LongText
  version              String
  acceptance_level     String   @default("usuario")
  // empresa | usuario
  target_account_types String?  @db.LongText
  // JSON: string[]
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  acceptances TermAcceptance[]

  @@map("terms")
}

model TermAcceptance {
  id          String   @id @default(cuid())
  term_id     String
  term        Term     @relation(fields: [term_id], references: [id])
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  accepted_at DateTime @default(now())
  ip_address  String?

  @@unique([term_id, user_id])
  @@map("term_acceptances")
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model Conversation {
  id         String   @id @default(cuid())
  title      String?
  type       String   @default("direct")
  // direct | group | support
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("conversations")
}

model ChatParticipant {
