DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
# Docker Compose local: mysql://allka:allka_dev@mysql:3306/allka
# MySQL local:          mysql://allka:allka_dev@localhost:3306/allka

JWT_SECRET="CHANGE_ME_USE_A_STRONG_SECRET_MIN_32_CHARS"
PORT=3001
NODE_ENV=development

# Senha dos 6 usuários de teste (admin/nomade/agencia/company/partner/lider).
# Se não definida, o seed usa o fallback "123456".
SEED_TEST_USER_PASSWORD="123456"

# Trava de segurança: o seed de usuários de teste é bloqueado em produção.
# Defina "true" apenas para liberar a execução em produção/staging.
ALLOW_TEST_USERS_SEED_IN_PRODUCTION="false"

# Gemini API — "Consultor IA" (preenchimento/melhoria de briefing de tarefas).
# Gerar em https://aistudio.google.com/apikey
GEMINI_API_KEY="CHANGE_ME"

# Allka <-> Roadmap integration (v1.1.0 contract) — server-to-server only.
# See docs/roadmap-integration-contract-v1.md. Leave PRODUCT_FEEDBACK_ENABLED
# unset/false until this is actually wired up end to end; every route
# refuses when it's off.
PRODUCT_FEEDBACK_ENABLED="false"
# IMPORTANT — verified local topology, don't assume "localhost" works:
# this backend runs inside its own Docker Compose project
# (allka-2026_default network); the Roadmap backend runs inside a SEPARATE
# Docker Compose project (allka-roadmap_default network). The two
# projects are not on a shared Docker network, so a container in one
# cannot resolve the other by container name, and "localhost" inside this
# container refers to this container, not the host machine.
# No trailing "/api" here — the Roadmap's own Express app already mounts
# every route (including the integration router) under "/api/..." itself
# (see allka-roadmap/apps/backend/src/app.ts); this is just host:port.
#   - This backend running in Docker (the default local setup):
#       ROADMAP_API_URL="http://host.docker.internal:3002"
#   - This backend running natively on the host (npm run dev:backend,
#     outside Docker):
#       ROADMAP_API_URL="http://localhost:3002"
ROADMAP_API_URL="http://host.docker.internal:3002"
ROADMAP_HMAC_KEY_ID="change-me-local-key-id"
ROADMAP_HMAC_SECRET="change-me-generate-a-long-random-local-secret"
ROADMAP_REQUEST_TIMEOUT_MS="5000"
# Only shown to Admin users, for an "Abrir painel interno" link — never
# sent to a common user. Leave unset to hide that link entirely.
ROADMAP_INTERNAL_URL="http://localhost:8090"
