# Copie para .env.local (gitignored, nunca commitado) para ter o login
# preenchido automaticamente ao abrir cada portal — só funciona rodando
# `npm run dev` e acessando via localhost/127.0.0.1 (ver
# lib/dev-login-credentials.ts). Em produção estas variáveis nunca existem
# no build, então os campos de login sempre começam vazios.

VITE_DEV_LOGIN_PASSWORD=CHANGE_ME

VITE_DEV_LOGIN_ADMIN_EMAIL=CHANGE_ME
VITE_DEV_LOGIN_AGENCY_EMAIL=CHANGE_ME
VITE_DEV_LOGIN_AGENCY_PARTNER_EMAIL=CHANGE_ME
VITE_DEV_LOGIN_COMPANY_EMAIL=CHANGE_ME
VITE_DEV_LOGIN_LEADER_EMAIL=CHANGE_ME
VITE_DEV_LOGIN_NOMAD_EMAIL=CHANGE_ME
